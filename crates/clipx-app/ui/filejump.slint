import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconFolder, IconStar, IconSearch } from "icons.slint";
import { UiCardShadow, UiScrollBar } from "widgets.slint";

// FileJump Picker（对齐 WPF PathLine：主行路径，次行来源/别名）

export struct FjRow {
    alias: string,
    path: string,
    source: string,
    index-label: string,
    source-kind: int,
}

export component FileJumpWindow inherits Window {
    in-out property <[FjRow]> rows;
    in-out property <int> selected-index: 0;
    in-out property <string> title-label: "跳转到文件夹";
    in-out property <string> search-text;
    in-out property <string> count-label;
    in-out property <string> hint-label: "↑↓ 选择 · ←→ 翻页 · Ctrl+N 跳转 · Enter 跳转 · Del 移除收藏/最近 · Esc 关闭";
    in-out property <int> first-visible: 0;

    callback row-activated(int);
    callback closed();
    callback drag-by(length, length);

    public function bring-into-view(index: int) {
        if (index < 0 || root.rows.length == 0) {
            return;
        }
        if (index * root.row-height + list.viewport-y < 0) {
            list.viewport-y = -index * root.row-height;
        }
        if ((index + 1) * root.row-height + list.viewport-y > list.visible-height) {
            list.viewport-y = list.visible-height - (index + 1) * root.row-height;
        }
        list.viewport-y = Math.max(list.viewport-y, Math.min(0, list.visible-height - root.rows.length * root.row-height));
        list.viewport-y = Math.min(list.viewport-y, 0);
    }

    changed selected-index => {
        root.bring-into-view(root.selected-index);
    }
    changed first-visible => {
        list.viewport-y = -root.first-visible * root.row-height;
        list.viewport-y = Math.max(list.viewport-y, Math.min(0, list.visible-height - root.rows.length * root.row-height));
        list.viewport-y = Math.min(list.viewport-y, 0);
    }

    title: "clipx-filejump";
    always-on-top: true;
    no-frame: true;
    default-font-family: "Segoe UI";
    // 注意 Slint 的 8 位十六进制是 #RRGGBBAA，不是 WPF 的 #AARRGGBB
    background: #00000001;
    preferred-width: 400px;
    preferred-height: 260px;

    private property <length> row-height: 36px;

    // 原"假阴影"矩形（#55000000，且几何被卡片盖住）已换成共用组件
    UiCardShadow {
        card-radius: 12px;
    }
    Rectangle {
        x: 16px;
        y: 16px;
        width: parent.width - 32px;
        height: parent.height - 32px;
        border-radius: 12px;
        // 卡片底色带约 5% 透明（对齐 WPF PopupBgBrush），详见 theme.slint 的 card-bg
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.border;
        // 死属性（软件渲染器忽略 drop-shadow-*），颜色按 Slint 顺序修正
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000080;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 12px;
            clip: true;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0;

            Rectangle {
                height: 40px;
                // WPF FileDialogJumpPickerWindow 的表头 <Grid Grid.Row="0" Margin="16,14,16,10">
                // 同样没有背景 —— 直接透明，卡片圆角自然透出。
                // （比「给表头加圆角」更稳：不会让表头区域比卡片本身更不透明。）
                background: transparent;

                drag-touch := TouchArea {
                    mouse-cursor: move;
                    property <bool> dragging: false;
                    property <length> press-x;
                    property <length> press-y;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            press-x = self.mouse-x;
                            press-y = self.mouse-y;
                            dragging = true;
                        }
                        if (event.kind == PointerEventKind.up) {
                            dragging = false;
                        }
                    }
                    moved => {
                        if (dragging) {
                            root.drag-by(self.mouse-x - press-x, self.mouse-y - press-y);
                            press-x = self.mouse-x;
                            press-y = self.mouse-y;
                        }
                    }
                }

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    // 内缩对齐另两个浮窗的表头（WPF 表头 Margin 水平 16）
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 0;
                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 0;
                        Rectangle {
                            width: 16px;
                            height: 22px;
                            IconFolder {
                                y: 4px;
                                fill: Theme.secondary-text;
                            }
                        }
                        Text {
                            text: root.title-label;
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.primary-text;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.count-label;
                        font-size: 12px;
                        color: Theme.secondary-text;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    // WPF 用的是 ThemeSeparator（比 ThemeBorder 浅一档）
                    background: Theme.separator;
                }
            }

            Rectangle {
                height: 36px;
                // 与卡片同色，透出卡片背景即可；不留不透明底色才能保住 card-bg 的 5% 透明
                background: transparent;
                Rectangle {
                    x: 8px;
                    y: 4px;
                    width: parent.width - 16px;
                    height: 28px;
                    background: Theme.input-bg;
                    border-radius: 8px;
                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 14px;
                            height: 100%;
                            IconSearch {
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        Text {
                            text: root.search-text == "" ? "键入过滤（含收藏别名）" : root.search-text;
                            font-size: 13px;
                            color: root.search-text == "" ? Theme.muted-text : Theme.primary-text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            list := ListView {
                x: 6px;
                // 右侧让出 12px 给滚动条轨道
                width: parent.width - 18px;
                vertical-stretch: 1;
                for row[i] in root.rows : Rectangle {
                    width: parent.width;
                    height: root.row-height;

                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.row-activated(i); }
                    }
                    Rectangle {
                        x: 2px;
                        y: 1px;
                        width: parent.width - 4px;
                        height: parent.height - 2px;
                        border-radius: 6px;
                        background: i == root.selected-index ? Theme.selected : (row-touch.has-hover ? Theme.hover : transparent);
                        // 选中/悬停淡入淡出，方向键扫过时不再硬闪
                        animate background { duration: 110ms; easing: ease-out; }

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            alignment: start;
                            Text {
                                width: 14px;
                                height: 100%;
                                text: row.index-label;
                                font-size: 10px;
                                color: Theme.muted-text;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            Rectangle {
                                width: 18px;
                                height: 100%;
                                if row.source-kind == 1: IconStar {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                                if row.source-kind != 1: IconFolder {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    fill: Theme.secondary-text;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: row.alias;
                                    font-size: 13px;
                                    color: Theme.primary-text;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.path;
                                    font-size: 10px;
                                    color: Theme.muted-text;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 32px;
                background: Theme.footer-bg;
                // 底栏与卡片不同色，自带圆角（原因同表头）
                border-bottom-left-radius: 12px;
                border-bottom-right-radius: 12px;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text {
                        text: root.hint-label;
                        font-size: 10px;
                        color: Theme.muted-text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
        }
    }

    // 滚动条：filejump 的列表是 VerticalLayout 的直接子项，布局会接管兄弟元素的 x/y，
    // 没法在列表旁边做绝对定位（写了也会被布局覆盖）。改为挂在 Window 根上，
    // 用列表的绝对坐标贴到它右侧——声明在卡片之后，z 序在卡片之上。
    UiScrollBar {
        x: list.absolute-position.x + list.width + 6px;
        y: list.absolute-position.y;
        height: list.height;
        content-height: root.rows.length * root.row-height;
        view-height: list.visible-height;
        progress: (root.rows.length * root.row-height - list.visible-height) <= 0px
            ? 0.0
            : Math.min(1.0, ((-list.viewport-y) / 1px)
                / ((root.rows.length * root.row-height - list.visible-height) / 1px));
        scrubbed(p) => {
            list.viewport-y = -(p * Math.max(0px, root.rows.length * root.row-height - list.visible-height));
        }
    }
}
