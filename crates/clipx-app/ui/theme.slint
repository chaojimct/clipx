// 全窗口共用色板。基色对齐 WPF ThemeManager（品牌青绿 #139493）。
//
// hover / selected 不是静态值：WPF 在 PopupWindow.ApplyListSelectionBrushesForMode
// 里按「当前批次模式主色 × 窗口底色」重算（浅色 5:20 / 10:15，深色 7:18 / 12:13）。
// 这里同样由 Rust 侧 palette() 混合下发，本文件的初值仅作未上色前的兜底。
export global Theme {
    in-out property <color> popup-bg: #1E1E1E;
    in-out property <color> window-bg: #1E1E1E;
    in-out property <color> surface: #252526;
    in-out property <color> hover: #1A3F3F;
    in-out property <color> selected: #185656;
    in-out property <color> primary-text: #CCCCCC;
    in-out property <color> secondary-text: #9D9D9D;
    in-out property <color> muted-text: #858585;
    in-out property <color> accent: #139493;
    in-out property <color> border: #3E3E42;
    in-out property <color> btn-bg: #252526;
    in-out property <color> btn-hover: #1A3F3F;
    in-out property <color> input-bg: #252526;
    in-out property <color> on-accent: #FFFFFF;
    in-out property <color> danger: #F48771;
    in-out property <color> track: #1E1E1E;
    in-out property <color> header-bg: #1E1E1E;
    in-out property <color> footer-bg: #252526;
    in-out property <color> frame-bg: #111111;
    /// 分隔线（WPF ThemeSeparator）：比 border 浅一档，表头/弹层内的分割用它。
    in-out property <color> separator: #3E3E42;
    /// 弹窗卡片底色（WPF `PopupBgBrush` = ARGB(0xF2,#1E1E1E) 暗 / ARGB(0xF5,#EFF1F5) 浅）：
    /// 比 popup-bg 多约 5% 透明，弹窗会微微透出桌面底。`popup-bg` 本身保持不透明，
    /// 留给卡片内的浮层（右键菜单 / 快捷键面板 / 复制条）——它们不该透。
    in-out property <color> card-bg: popup-bg.transparentize(0.05);
    /// 卡片上沿 1px 内高光（见 widgets.slint 的 UiCardSheen）。亮底要更强的白，
    /// 暗底只需一丝；由 Rust 侧按窗口底色亮度算好下发，本文件的初值只作兜底。
    in-out property <color> card-sheen: #FFFFFF0F;
}
