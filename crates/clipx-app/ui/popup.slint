import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { UiPill, UiIconBtn } from "widgets.slint";
import { IconMark, IconClipboard, IconSearch } from "icons.slint";

// 再导出快速查找窗口与 FileJump 窗口（本文件是唯一 slint 编译入口）
export { QuickFindWindow, QfRow } from "quickfind.slint";
export { FileJumpWindow, FjRow } from "filejump.slint";
export { SettingsWindow } from "settings.slint";
export { Theme } from "theme.slint";

export struct RowData {
    id: int,
    kind: int,
    icon: string,
    index-label: string,
    preview: string,
    hit-pre: string,
    hit: string,
    hit-post: string,
    sub: string,
    time-ago: string,
    thumb: image,
    has-thumb: bool,
    idx: int,
    picked: bool,
    current: bool,
    pending-delete: bool,
}

export struct MenuRow {
    label: string,
    action: string,
    danger: bool,
    hot: bool,
}

// OCR 行框（图上高亮用；x/y/w/h 归一化 0-1）。
export struct OcrLine {
    text: string,
    x: float,
    y: float,
    w: float,
    h: float,
}

// OCR 词框（扁平阅读序；中文 1-3 字约等于按字选）。
export struct OcrWord {
    text: string,
    x: float,
    y: float,
    w: float,
    h: float,
}

// ===== 菜单条目（右键上下文菜单用）=====
component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> hot: false;
    callback activate();

    height: 36px;
    border-radius: 6px;
        background: root.hot || entry-touch.has-hover ? Theme.selected : transparent;

    entry-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }

    Text {
        x: 12px;
        text: root.label;
        font-size: 13px;
        color: root.danger ? #E06C75 : Theme.primary-text;
        vertical-alignment: center;
    }
}

export component PopupWindow inherits Window {
    in-out property <[RowData]> rows;
    in-out property <int> selected-index: 0;
    /// 仅一行悬停：ListView 里 TouchArea.has-hover 会串到邻行
    in-out property <int> hover-index: -1;
    in-out property <bool> search-active: false;
    in-out property <string> search-text;
    in-out property <string> search-count;
    in-out property <string> type-filter-label: "全部";
    in-out property <string> item-count: "";
    in-out property <string> batch-label: "普通";
    in-out property <string> footer-hint: "Ctrl+N快贴 · ↑↓选择 · Home/End首尾 · PgUp/Dn翻页 · Enter粘贴";
    in-out property <float> list-width-px: 404;
    in-out property <bool> window-pinned: false;
    in-out property <bool> text-edit-open: false;
    in-out property <string> text-edit-buffer: "";

    // ===== 预览模式（Space 切换，对齐 WPF 版条目预览）=====
    in-out property <bool> preview-active: false;
    in-out property <bool> preview-has-image: false;
    in-out property <image> preview-image;
    in-out property <string> preview-text;
    in-out property <string> preview-info: "预览";
    in-out property <bool> preview-mono: false;
    // OCR 行/词框（图片条目；空 = 无框旧数据/全文模式）
    in-out property <[OcrLine]> preview-ocr-lines;
    in-out property <[OcrWord]> preview-ocr-words;
    // 预览解码图原始像素尺寸（叠加层 contain 映射用；长宽比与原图一致）
    in-out property <float> preview-img-w: 1.0;
    in-out property <float> preview-img-h: 1.0;
    // 图上 OCR 选区（归一化有序矩形）：松开不清，右键/复制条/Ctrl+C 才拷
    in-out property <float> preview-sel-x0: 0;
    in-out property <float> preview-sel-y0: 0;
    in-out property <float> preview-sel-x1: 0;
    in-out property <float> preview-sel-y1: 0;
    in-out property <bool> preview-sel-active: false;
    in-out property <int> preview-seq: 0;
    in-out property <bool> preview-loading: false;
    in-out property <float> preview-zoom: 1.0;
    in-out property <length> preview-off-x: 0px;
    in-out property <length> preview-off-y: 0px;

    // ===== 右键上下文菜单（Menu 键 / 鼠标右键，M3）=====
    in-out property <bool> menu-visible: false;
    in-out property <int> menu-index: -1;
    in-out property <[MenuRow]> menu-rows;
    in-out property <length> menu-y: 0px;

    // ===== 快捷短语编辑浮层 =====
    in-out property <bool> phrase-edit-open: false;
    in-out property <string> phrase-edit-preview: "";
    in-out property <string> phrase-edit-buffer: "";
    in-out property <float> row-height-px: 40;
    in-out property <float> panel-opacity: 1.0;
    in-out property <int> first-visible: 0;
    /// 兼容旧绑定；全量 ListView 下恒为 0。
    in-out property <int> row-base: 0;
    in-out property <int> total-count: 0;

    callback row-clicked(int);
    callback row-double-clicked(int);
    callback filter-clicked();
    callback batch-clicked();
    /// 批量模式胶囊右键：打开批量菜单（对齐 WPF BatchModeHeader_RightClick）
    callback batch-menu();
    /// 右键某行：请求打开菜单（Slint 侧先锚定行并就位；index 同步选中）
    callback menu-requested(int);
    /// 菜单动作
    callback menu-action(string);
    callback menu-close();
    callback open-settings();
    callback pin-window();
    callback title-drag(length, length);
    callback middle-preview(int);
    /// 预览图双击：复制 OCR 全文 / 正文
    callback preview-double-clicked();
    /// 预览 OCR 点选：归一化图坐标，选中最小命中词/行（点空清选区）
    callback preview-select-ocr-point(float, float);
    /// 预览 OCR 框选：归一化矩形，选中命中行/词（过小视为点选）
    callback preview-select-ocr-rect(float, float, float, float);
    /// 复制当前图上选区（弹窗与选区保留）
    callback preview-copy-selection();
    /// 预览正文焦点变化：聚焦时键盘走 TextInput 原生（选区/复制），钩子只留 Esc/Enter
    callback preview-text-focus(bool);
    /// 预览滚轮缩放：Rust 侧按需补高清源图，不重置 zoom。
    callback preview-zoomed(float);
    /// 滚轮只同步 Ctrl+N 首行与懒加载缩略图，禁止回写列表。
    callback list-scrolled(int);
    callback text-edit-changed(string);
    callback text-edit-save();
    callback text-edit-cancel();
    callback phrase-edit-changed(string);
    callback phrase-edit-save();
    callback phrase-edit-cancel();

    /// 键盘 Menu 键路径：按选中行索引计算菜单 y（右键路径不需要）
    /// 菜单锚定的行：菜单贴着该行上/下方弹，不盖住本行。
    property <int> menu-anchor: -1;
    public function menu-position-at(index: int) {
        root.menu-anchor = index;
        root.place-menu();
    }
    /// 菜单就位：优先放锚定行下方，放不下放上方，都放不下才钳制。
    /// 右键瞬间行数还是旧的（Rust 回包后才更新），靠 changed menu-rows 再纠一次。
    public function place-menu() {
        if (!root.menu-visible || root.menu-anchor < 0 || root.menu-rows.length == 0) {
            return;
        }
        let h = 8px + root.menu-rows.length * 36px;
        let row-top = root.menu-anchor * root.row-height + list.viewport-y;
        let row-bot = row-top + root.row-height;
        let list-h = list.visible-height > 0px ? list.visible-height : list.height;
        if (row-bot + 4px + h <= list-h) {
            root.menu-y = row-bot + 4px;
        } else if (row-top - 4px - h >= 0px) {
            root.menu-y = row-top - 4px - h;
        } else {
            root.menu-y = Math.max(4px, list-h - h - 4px);
        }
    }
    changed menu-rows => {
        // Rust 回包（行数从旧变新）后按真实高度重排，底部行不再被裁。
        root.place-menu();
    }

    title: "clipx";
    always-on-top: true;
    no-frame: true;
    default-font-family: "Segoe UI";
    // 与 WPF AllowsTransparency 相同：1 级 alpha 保住阴影区域。
    background: #01000000;
    preferred-width: 452px;
    preferred-height: 592px;

    changed selected-index => {
        root.bring-into-view(root.selected-index);
    }
    changed preview-seq => {
        root.preview-zoom = 1.0;
        root.preview-off-x = 0px;
        root.preview-off-y = 0px;
    }
    changed preview-active => {
        if (!root.preview-active) {
            root.preview-zoom = 1.0;
            root.preview-off-x = 0px;
            root.preview-off-y = 0px;
        }
    }
    changed first-visible => {
        let target = -root.first-visible * root.row-height;
        if (Math.abs(target - list.viewport-y) > root.row-height * 1.5) {
            list.viewport-y = -root.first-visible * root.row-height;
            list.viewport-y = Math.max(list.viewport-y, Math.min(0, list.visible-height - root.rows.length * root.row-height));
            list.viewport-y = Math.min(list.viewport-y, 0);
        }
    }
    /// 只在整行变化时回调，不要绑 viewport-y（否则每个像素都进 Rust）。
    property <int> est-first: Math.max(0, Math.min(Math.round(-list.viewport-y / root.row-height), Math.max(0, root.rows.length - 1)));
    changed est-first => {
        if (root.rows.length > 0) {
            root.list-scrolled(root.est-first);
        }
    }

    private property <length> row-height: root.row-height-px * 1px;
    private property <bool> help-open: false;

    public function bring-into-view(index: int) {
        if (index < 0 || root.rows.length == 0) {
            return;
        }
        if (index * root.row-height + list.viewport-y < 0) {
            list.viewport-y = -index * root.row-height;
        }
        if ((index + 1) * root.row-height + list.viewport-y > list.visible-height) {
            list.viewport-y = list.visible-height - (index + 1) * root.row-height;
        }
        list.viewport-y = Math.max(list.viewport-y, Math.min(0, list.visible-height - root.rows.length * root.row-height));
        list.viewport-y = Math.min(list.viewport-y, 0);
    }

    // 阴影画在卡片外：外层不能 clip。软件渲染的 drop-shadow 经常看不见，补一层假阴影。
    Rectangle {
        x: 20px;
        y: 22px;
        width: parent.width - 40px;
        height: parent.height - 38px;
        border-radius: 14px;
        background: #55000000;
    }
    Rectangle {
        x: 16px;
        y: 16px;
        width: parent.width - 32px;
        height: parent.height - 32px;
        border-radius: 12px;
        background: Theme.popup-bg;
        border-width: 1px;
        border-color: Theme.border;
        opacity: root.panel-opacity;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #60000000;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 12px;
            clip: true;

        HorizontalLayout {
            padding: 0;
            spacing: 0;

            list-col := VerticalLayout {
                // 无预览铺满卡片；固定 list-width-px 会比卡片更宽，顶栏/底栏被 clip 后贴边。
                width: root.preview-active ? root.list-width-px * 1px : parent.width;
                padding: 0;
                spacing: 0;

            // ===== 头部：标题 + 计数 + 类型筛选 =====
            Rectangle {
                height: 44px;
                background: Theme.popup-bg;
                header-drag := TouchArea {
                    mouse-cursor: move;
                    property <bool> dragging: false;
                    property <length> press-x;
                    property <length> press-y;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            press-x = self.mouse-x;
                            press-y = self.mouse-y;
                            dragging = true;
                        }
                        if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            dragging = false;
                        }
                    }
                    moved => {
                        if (dragging) {
                            root.title-drag(self.mouse-x - press-x, self.mouse-y - press-y);
                        }
                    }
                }
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 11px;
                    padding-bottom: 11px;
                    spacing: 0;

                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 0;
                        Rectangle {
                            width: 14px;
                            height: 22px;
                            IconClipboard {
                                y: 3px;
                                fill: Theme.secondary-text;
                            }
                        }
                        Text {
                            text: "剪贴板历史";
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.primary-text;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.item-count;
                            font-size: 12px;
                            color: Theme.secondary-text;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    HorizontalLayout {
                        spacing: 0;
                        horizontal-stretch: 0;
                        UiPill {
                            text: root.batch-label;
                            filled: true;
                            clicked => { root.batch-clicked(); }
                            right-clicked => { root.batch-menu(); }
                        }
                        Rectangle { width: 8px; }
                        UiIconBtn {
                            kind: 0;
                            on: root.window-pinned;
                            clicked => { root.pin-window(); }
                        }
                        Rectangle { width: 4px; }
                        UiIconBtn {
                            kind: 1;
                            clicked => { root.open-settings(); }
                        }
                        Rectangle { width: 8px; }
                        UiPill {
                            text: root.type-filter-label;
                            clicked => { root.filter-clicked(); }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: Theme.border;
                }
            }

            // ===== 搜索栏（搜索时显示）=====
            if root.search-active: Rectangle {
                height: 40px;
                Rectangle {
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    height: 28px;
                    border-radius: 8px;
                    background: Theme.input-bg;
                    border-width: 1px;
                    border-color: Theme.accent;
                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 14px;
                            height: 100%;
                            IconSearch {
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        Text {
                            text: root.search-text;
                            font-size: 13px;
                            color: Theme.primary-text;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.search-count;
                            font-size: 11px;
                            color: Theme.secondary-text;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ===== 列表 / 空状态 =====
            Rectangle {
                vertical-stretch: 1;

                list := ListView {
                    x: 6px;
                    width: parent.width - 12px;
                    y: 0;
                    height: parent.height;

                    for row[index] in root.rows: row-rect := Rectangle {
                        width: 100%;
                        height: root.row-height;
                        opacity: row.pending-delete ? 0.55 : 1.0;

                        row-touch := TouchArea {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            double-clicked => { root.row-double-clicked(index); }
                            moved => { root.hover-index = index; }
                            changed has-hover => {
                                if (!row-touch.has-hover && root.hover-index == index) {
                                    root.hover-index = -1;
                                }
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    root.row-clicked(index);
                                }
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                    root.menu-anchor = index;
                                    root.place-menu();
                                    root.menu-requested(index);
                                }
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.middle) {
                                    root.middle-preview(index);
                                }
                            }
                        }

                        Rectangle {
                            x: 2px;
                            y: 1px;
                            width: parent.width - 4px;
                            height: parent.height - 2px;
                            border-radius: 6px;
                            // 当前行只跟 selected-index（方向键轻量刷新会改这个）。
                            // picked 仅表示多选里的其余行，单选时全为 false。
                            background: index == root.selected-index || row.picked
                                ? Theme.selected
                                : (root.hover-index == index ? Theme.hover : transparent);

                            if index == root.selected-index: Rectangle {
                                x: 0px;
                                y: 6px;
                                width: 3px;
                                height: parent.height - 12px;
                                border-radius: 2px;
                                background: Theme.accent;
                            }

                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;

                                Text {
                                    width: 14px;
                                    height: 100%;
                                    property <int> vis-n: index - root.est-first + 1;
                                    text: vis-n >= 1 && vis-n <= 9 ? vis-n : "";
                                    font-size: 10px;
                                    color: Theme.muted-text;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                                Rectangle {
                                    width: 28px;
                                    height: 100%;
                                    Rectangle {
                                        x: 0px;
                                        y: (parent.height - 28px) / 2;
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 4px;
                                        background: row.has-thumb ? Theme.surface : transparent;
                                        clip: true;
                                        if row.has-thumb: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: row.thumb;
                                            image-fit: cover;
                                        }
                                        if !row.has-thumb: IconMark {
                                            kind: row.kind;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 1px;
                                    HorizontalLayout {
                                        spacing: 0px;
                                        alignment: start;
                                        if row.hit == "": Text {
                                            text: row.preview;
                                            font-size: 13px;
                                            color: Theme.primary-text;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if row.hit != "" && row.hit-pre != "": Text {
                                            text: row.hit-pre;
                                            font-size: 13px;
                                            color: Theme.primary-text;
                                            vertical-alignment: center;
                                            horizontal-stretch: 0;
                                        }
                                        if row.hit != "": Text {
                                            text: row.hit;
                                            font-size: 13px;
                                            color: Theme.accent;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            horizontal-stretch: 0;
                                        }
                                        if row.hit != "": Text {
                                            text: row.hit-post;
                                            font-size: 13px;
                                            color: Theme.primary-text;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    if row.sub != "": Text {
                                        text: row.sub;
                                        font-size: 10px;
                                        color: Theme.muted-text;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    height: 100%;
                                    text: row.time-ago;
                                    font-size: 11px;
                                    color: Theme.secondary-text;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }

                if root.rows.length == 0: Rectangle {
                    background: Theme.popup-bg;
                    if root.search-active: VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "🔍";
                            font-size: 28px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "无匹配结果";
                            font-size: 13px;
                            color: Theme.secondary-text;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "可试拼音全拼或首字母，如「nihao」「nh」";
                            font-size: 11px;
                            color: Theme.muted-text;
                            horizontal-alignment: center;
                        }
                    }
                    if !root.search-active: VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "📭";
                            font-size: 28px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "暂无剪贴板记录";
                            font-size: 13px;
                            color: Theme.secondary-text;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "复制一些文本即可开始";
                            font-size: 11px;
                            color: Theme.muted-text;
                            horizontal-alignment: center;
                        }
                    }
                }

                // ===== 右键上下文菜单浮层（列表容器坐标系，z 序最上）=====
                if root.menu-visible: Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                // 点击菜单外任意处关闭（吃掉点击，不落到行上）；
                // 右键其他行：菜单直接跟过去，不用先 Esc/左键关。
                menu-shield := TouchArea {
                    clicked => {
                        root.menu-visible = false;
                        root.menu-close();
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right && root.rows.length > 0) {
                            // 遮罩与列表同坐标系（list.x=6px,y=0）：按 y 反推行号。
                            let idx = Math.max(0, Math.min(root.rows.length - 1,
                                Math.floor((self.mouse-y - list.viewport-y) / root.row-height)));
                            root.menu-anchor = idx;
                            root.place-menu();
                            root.menu-requested(idx);
                        }
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                            // 兜底：实现 pointer-event 后若 clicked 不再触发，左键松开同样关菜单。
                            if (root.menu-visible) {
                                root.menu-visible = false;
                                root.menu-close();
                            }
                        }
                    }
                }

                    Rectangle {
                    x: 72px;
                    y: root.menu-y;
                    width: 268px;
                    height: 8px + root.menu-rows.length * 36px;
                    border-radius: 10px;
                    background: Theme.popup-bg;
                    border-width: 1px;
                    border-color: Theme.border;
                    drop-shadow-blur: 12px;
                    drop-shadow-offset-y: 2px;
                    drop-shadow-color: #90000000;

                    VerticalLayout {
                        padding: 4px;
                        spacing: 0;

                        for item in root.menu-rows: MenuEntry {
                            label: item.label;
                            danger: item.danger;
                            hot: item.hot;
                            activate => {
                                root.menu-visible = false;
                                root.menu-action(item.action);
                            }
                        }
                    }
                }
            }
            }

            // ===== 底部提示栏 =====
            Rectangle {
                height: 36px;
                background: Theme.footer-bg;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    Text {
                        text: root.footer-hint;
                        font-size: 10px;
                        color: Theme.muted-text;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        height: 20px;
                        vertical-stretch: 0;
                        border-radius: 10px;
                        background: Theme.accent;
                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            Text {
                                text: "more";
                                font-size: 10px;
                                font-weight: 600;
                                color: Theme.on-accent;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.help-open = !root.help-open; }
                        }
                    }
                }
            }
            }

            if root.preview-active: Rectangle {
                width: 1px;
                background: Theme.border;
            }

            if root.preview-active: Rectangle {
                horizontal-stretch: 1;
                background: Theme.window-bg;
                clip: true;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: root.preview-info;
                        font-size: 11px;
                        color: Theme.secondary-text;
                        overflow: elide;
                    }

                    // 图片容器：仅图片条目（含加载中）显示。
                    // 纯文本/文件列表/富文本不占位（对齐 WPF PreviewShowsImagePanel）。
                    if root.preview-has-image || root.preview-loading: img-box := Rectangle {
                        vertical-stretch: 1;
                        border-radius: 8px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;

                        if root.preview-has-image: Image {
                            x: root.preview-off-x;
                            y: root.preview-off-y;
                            width: parent.width * root.preview-zoom;
                            height: parent.height * root.preview-zoom;
                            source: root.preview-image;
                            image-fit: contain;
                        }

                        if root.preview-loading: Rectangle {
                            background: root.preview-has-image ? #99000000 : transparent;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: "加载中…";
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.primary-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            enabled: root.preview-has-image;
                            mouse-cursor: root.preview-zoom > 1.01 ? move : pointer;
                            property <bool> panning: false;
                            property <length> last-x;
                            property <length> last-y;
                            // 双击大图 = 复制 OCR 全文（菜单「复制文字（OCR）」同效）
                            double-clicked => { root.preview-double-clicked(); }
                            scroll-event(event) => {
                                if (!root.preview-has-image) {
                                    return reject;
                                }
                                let old-z = root.preview-zoom;
                                let dy = event.delta-y / 1px;
                                let factor = dy > 0 ? 1.12 : 0.89;
                                let z = Math.max(1.0, Math.min(8.0, old-z * factor));
                                let mx = self.mouse-x;
                                let my = self.mouse-y;
                                let cx = (mx - root.preview-off-x) / old-z;
                                let cy = (my - root.preview-off-y) / old-z;
                                root.preview-zoom = z;
                                root.preview-off-x = mx - cx * z;
                                root.preview-off-y = my - cy * z;
                                if (z <= 1.001) {
                                    root.preview-off-x = 0px;
                                    root.preview-off-y = 0px;
                                    root.preview-zoom = 1.0;
                                }
                                root.preview-zoomed(root.preview-zoom);
                                return accept;
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    panning = root.preview-zoom > 1.01;
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                }
                                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                    panning = false;
                                }
                            }
                            moved => {
                                if (panning) {
                                    root.preview-off-x += self.mouse-x - last-x;
                                    root.preview-off-y += self.mouse-y - last-y;
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                }
                            }
                        }

                        // OCR 高亮叠加层（微信预览/PixPin 贴图式）：
                        // 原图干净展示；拖选/已选命中的词直接在原字上变蓝；
                        // 字上按下=选词，空白处按下=框选（1x）/平移（放大时）；
                        // 松开定选区，右键/复制条/Ctrl+C 复制。
                        if root.preview-has-image && root.preview-ocr-lines.length > 0: ocr-layer := Rectangle {
                            property <float> s0: Math.min(img-box.width / 1px / Math.max(1.0, root.preview-img-w), img-box.height / 1px / Math.max(1.0, root.preview-img-h));
                            property <float> sc: Math.max(0.001, self.s0 * root.preview-zoom);
                            property <length> dw: root.preview-img-w * self.sc * 1px;
                            property <length> dh: root.preview-img-h * self.sc * 1px;
                            property <length> ew: img-box.width * root.preview-zoom;
                            property <length> eh: img-box.height * root.preview-zoom;
                            x: root.preview-off-x + (self.ew - self.dw) / 2;
                            y: root.preview-off-y + (self.eh - self.dh) / 2;
                            width: self.dw;
                            height: self.dh;

                            // 全图手势层（盒子之下）：空白处按下。
                            // 放大时=平移，1x=框选；右键=复制选区；双击=全文。
                            // 字上按下由各词盒接管（选词），本层只收空白处。
                            drag-touch := TouchArea {
                                in-out property <bool> dragging: false;
                                in-out property <bool> panning: false;
                                in-out property <float> sx: 0;
                                in-out property <float> sy: 0;
                                in-out property <float> ex: 0;
                                in-out property <float> ey: 0;
                                property <float> last-x: 0;
                                property <float> last-y: 0;
                                double-clicked => { root.preview-double-clicked(); }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        dragging = true;
                                        panning = root.preview-zoom > 1.01;
                                        sx = (self.mouse-x / 1px) / (parent.width / 1px);
                                        sy = (self.mouse-y / 1px) / (parent.height / 1px);
                                        ex = sx;
                                        ey = sy;
                                        last-x = self.mouse-x / 1px;
                                        last-y = self.mouse-y / 1px;
                                    }
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                        root.preview-copy-selection();
                                    }
                                    if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                        if (dragging) {
                                            dragging = false;
                                            if (panning) {
                                                panning = false;
                                            } else if (Math.abs(ex - sx) * parent.width > 4px || Math.abs(ey - sy) * parent.height > 4px) {
                                                root.preview-select-ocr-rect(sx, sy, ex, ey);
                                            } else {
                                                root.preview-select-ocr-point(sx, sy);
                                            }
                                        }
                                    }
                                }
                                moved => {
                                    if (dragging) {
                                        if (panning) {
                                            root.preview-off-x += (self.mouse-x / 1px - last-x) * 1px;
                                            root.preview-off-y += (self.mouse-y / 1px - last-y) * 1px;
                                            last-x = self.mouse-x / 1px;
                                            last-y = self.mouse-y / 1px;
                                        } else {
                                            ex = (self.mouse-x / 1px) / (parent.width / 1px);
                                            ey = (self.mouse-y / 1px) / (parent.height / 1px);
                                        }
                                    }
                                }
                            }

                            // 命中高亮（词优先；无词旧数据回退行；纯展示）：
                            // 拖选中实时跟随，松开后已选区常亮。背景透明，只蓝命中的字。
                            // 字上按下由各盒自带 TouchArea 接管（选词），空白处落到 drag-touch。
                            for word in root.preview-ocr-words: Rectangle {
                                x: word.x * parent.width;
                                y: word.y * parent.height;
                                width: Math.max(2px, word.w * parent.width);
                                height: Math.max(4px, word.h * parent.height);
                                border-radius: 2px;
                                property <float> cx: word.x + word.w / 2;
                                property <float> cy: word.y + word.h / 2;
                                background: ((drag-touch.dragging
                                    && (Math.abs(drag-touch.ex - drag-touch.sx) > 0.005 || Math.abs(drag-touch.ey - drag-touch.sy) > 0.005)
                                    && cx >= Math.min(drag-touch.sx, drag-touch.ex)
                                    && cx <= Math.max(drag-touch.sx, drag-touch.ex)
                                    && cy >= Math.min(drag-touch.sy, drag-touch.ey)
                                    && cy <= Math.max(drag-touch.sy, drag-touch.ey))
                                    || (root.preview-sel-active
                                    && cx >= root.preview-sel-x0
                                    && cx <= root.preview-sel-x1
                                    && cy >= root.preview-sel-y0
                                    && cy <= root.preview-sel-y1)) ? #664D9DE6 : transparent;
                                wtouch := TouchArea {
                                    mouse-cursor: pointer;
                                    property <bool> armed: false;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                            armed = true;
                                            drag-touch.dragging = true;
                                            drag-touch.panning = false;
                                            drag-touch.sx = word.x + (self.mouse-x / 1px) / (ocr-layer.width / 1px);
                                            drag-touch.sy = word.y + (self.mouse-y / 1px) / (ocr-layer.height / 1px);
                                            drag-touch.ex = drag-touch.sx;
                                            drag-touch.ey = drag-touch.sy;
                                        }
                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                            root.preview-copy-selection();
                                        }
                                        if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                            if (armed) {
                                                armed = false;
                                                drag-touch.dragging = false;
                                                if (Math.abs(drag-touch.ex - drag-touch.sx) * ocr-layer.width > 4px || Math.abs(drag-touch.ey - drag-touch.sy) * ocr-layer.height > 4px) {
                                                    root.preview-select-ocr-rect(drag-touch.sx, drag-touch.sy, drag-touch.ex, drag-touch.ey);
                                                } else {
                                                    root.preview-select-ocr-point(drag-touch.sx, drag-touch.sy);
                                                }
                                            }
                                        }
                                    }
                                    moved => {
                                        if (armed) {
                                            drag-touch.ex = word.x + (self.mouse-x / 1px) / (ocr-layer.width / 1px);
                                            drag-touch.ey = word.y + (self.mouse-y / 1px) / (ocr-layer.height / 1px);
                                        }
                                    }
                                    double-clicked => { root.preview-double-clicked(); }
                                }
                            }
                            for line in root.preview-ocr-lines: Rectangle {
                                x: line.x * parent.width;
                                y: line.y * parent.height;
                                width: Math.max(2px, line.w * parent.width);
                                height: Math.max(4px, line.h * parent.height);
                                border-radius: 2px;
                                property <float> cx: line.x + line.w / 2;
                                property <float> cy: line.y + line.h / 2;
                                background: (root.preview-ocr-words.length == 0 && ((drag-touch.dragging
                                    && (Math.abs(drag-touch.ex - drag-touch.sx) > 0.005 || Math.abs(drag-touch.ey - drag-touch.sy) > 0.005)
                                    && cx >= Math.min(drag-touch.sx, drag-touch.ex)
                                    && cx <= Math.max(drag-touch.sx, drag-touch.ex)
                                    && cy >= Math.min(drag-touch.sy, drag-touch.ey)
                                    && cy <= Math.max(drag-touch.sy, drag-touch.ey))
                                    || (root.preview-sel-active
                                    && cx >= root.preview-sel-x0
                                    && cx <= root.preview-sel-x1
                                    && cy >= root.preview-sel-y0
                                    && cy <= root.preview-sel-y1))) ? #664D9DE6 : transparent;
                                ltouch := TouchArea {
                                    visible: root.preview-ocr-words.length == 0;
                                    mouse-cursor: pointer;
                                    property <bool> armed: false;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                            armed = true;
                                            drag-touch.dragging = true;
                                            drag-touch.panning = false;
                                            drag-touch.sx = line.x + (self.mouse-x / 1px) / (ocr-layer.width / 1px);
                                            drag-touch.sy = line.y + (self.mouse-y / 1px) / (ocr-layer.height / 1px);
                                            drag-touch.ex = drag-touch.sx;
                                            drag-touch.ey = drag-touch.sy;
                                        }
                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                            root.preview-copy-selection();
                                        }
                                        if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                            if (armed) {
                                                armed = false;
                                                drag-touch.dragging = false;
                                                if (Math.abs(drag-touch.ex - drag-touch.sx) * ocr-layer.width > 4px || Math.abs(drag-touch.ey - drag-touch.sy) * ocr-layer.height > 4px) {
                                                    root.preview-select-ocr-rect(drag-touch.sx, drag-touch.sy, drag-touch.ex, drag-touch.ey);
                                                } else {
                                                    root.preview-select-ocr-point(drag-touch.sx, drag-touch.sy);
                                                }
                                            }
                                        }
                                    }
                                    moved => {
                                        if (armed) {
                                            drag-touch.ex = line.x + (self.mouse-x / 1px) / (ocr-layer.width / 1px);
                                            drag-touch.ey = line.y + (self.mouse-y / 1px) / (ocr-layer.height / 1px);
                                        }
                                    }
                                    double-clicked => { root.preview-double-clicked(); }
                                }
                            }

                            // 复制条：选区存在即显示在选区下方（放不下挪上方），
                            // 点击复制（弹窗选区保留，可连续复制）。
                            if root.preview-sel-active: Rectangle {
                                width: 76px;
                                height: 26px;
                                property <length> try-y: root.preview-sel-y1 * parent.height + 4px;
                                x: Math.min(Math.max(0px, root.preview-sel-x0 * parent.width), parent.width - 76px);
                                y: Math.max(0px, try-y + 26px <= parent.height ? try-y : root.preview-sel-y0 * parent.height - 30px);
                                border-radius: 6px;
                                background: Theme.popup-bg;
                                border-width: 1px;
                                border-color: Theme.accent;
                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "复制";
                                    font-size: 12px;
                                    color: Theme.accent;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.preview-copy-selection(); }
                                }
                            }
                        }
                    }

                    // 预览正文：只读 TextInput，原生支持鼠标拖选 + Ctrl+C。
                    // 行列表已删（全文=各行拼接；行复制走图上框）。
                    if root.preview-text != "": Rectangle {
                        vertical-stretch: root.preview-has-image ? 0 : 1;
                        min-height: root.preview-has-image ? 120px : 80px;
                        max-height: root.preview-has-image ? 120px : 9999px;
                        border-radius: 8px;
                        background: Theme.surface;
                        clip: true;
                        preview-text-input := TextInput {
                            x: 10px;
                            y: 10px;
                            width: parent.width - 20px;
                            height: parent.height - 20px;
                            text: root.preview-text;
                            // 对齐 WPF 预览 13px；等宽 JSON 12px。
                            font-size: root.preview-mono ? 12px : 13px;
                            font-family: root.preview-mono ? "Consolas" : "Segoe UI";
                            color: Theme.primary-text;
                            // char-wrap：中文无空格段落与长 URL/token 必须按字断行。
                            wrap: char-wrap;
                            single-line: false;
                            read-only: true;
                            selection-background-color: Theme.accent;
                            selection-foreground-color: Theme.on-accent;
                            changed has-focus => { root.preview-text-focus(self.has-focus); }
                        }
                    }

                    // 图片才有缩放/平移；纯文本显示粘贴提示。
                    Text {
                        text: root.preview-has-image ? (root.preview-ocr-lines.length > 0 ? "字上拖选 · 空白拖拽框选/平移 · 右键/复制条/Ctrl+C 复制 · 双击全文 · 滚轮缩放" : "双击复制文字 · 滚轮缩放 · Space 关闭预览") : "拖选文字复制 · Enter 粘贴 · Space 关闭预览";
                        font-size: 10px;
                        color: Theme.muted-text;
                    }
                }
        }

        if root.help-open: Rectangle {
            width: 100%;
            height: 100%;
            TouchArea { clicked => { root.help-open = false; } }
            Rectangle {
                x: parent.width - 340px;
                y: parent.height - 280px;
                width: 308px;
                height: 248px;
                border-radius: 10px;
                background: Theme.popup-bg;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: #73000000;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    Text {
                        text: "快捷键";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.primary-text;
                    }
                    Text {
                        text: "主键+N 快贴当前可见序号\n↑↓ 选择  ·  ←→ / PgUp/Dn 翻页  ·  Home/End 首尾\nEnter 粘贴（多选=连贴/合并）  ·  Ctrl+Enter 每条换行\nShift+Enter 粘贴图片 OCR 文字\nTab 筛选类型  ·  主键+Tab 仅看短语\na-z 拼音搜索  ·  Space/中键 预览（图上文本块拖选复制，复制按钮全块复制，双击全文，滚轮缩放，多图文件 ←→ 切图）\nShift+↑↓ / Shift+单击 连选  ·  Ctrl+单击 加减\nDel×2 删除  ·  Alt 菜单（FIFO/LIFO 或队列非空时为批量菜单）\nEsc 关菜单/预览/搜索/面板";
                        font-size: 12px;
                        color: Theme.secondary-text;
                        wrap: word-wrap;
                    }
                }
            }
        }

        if root.phrase-edit-open: Rectangle {
            width: 100%;
            height: 100%;
            background: #80000000;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 320px;
                        border-radius: 10px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text {
                                text: "设为快捷短语";
                                font-size: 14px;
                                color: Theme.primary-text;
                            }
                            Text {
                                text: root.phrase-edit-preview;
                                font-size: 12px;
                                color: Theme.secondary-text;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                height: 36px;
                                border-radius: 8px;
                                background: Theme.window-bg;
                                border-width: 1px;
                                border-color: Theme.accent;
                                phrase-inp := TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: 100%;
                                    text: root.phrase-edit-buffer;
                                    font-size: 13px;
                                    color: Theme.primary-text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    edited => { root.phrase-edit-changed(self.text); }
                                    init => { self.focus(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Enter 确认 · Esc 取消";
                                    font-size: 11px;
                                    color: Theme.muted-text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.phrase-edit-cancel(); }
                                    Text { text: "取消"; font-size: 12px; color: Theme.secondary-text; }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.phrase-edit-save(); }
                                    Text { text: "保存"; font-size: 12px; color: Theme.accent; }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.text-edit-open: Rectangle {
            width: 100%;
            height: 100%;
            background: #80000000;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 360px;
                        border-radius: 10px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text {
                                text: "编辑文本";
                                font-size: 14px;
                                color: Theme.primary-text;
                            }
                            Rectangle {
                                height: 160px;
                                border-radius: 8px;
                                background: Theme.window-bg;
                                border-width: 1px;
                                border-color: Theme.accent;
                                edit-inp := TextInput {
                                    x: 10px;
                                    y: 8px;
                                    width: parent.width - 20px;
                                    height: parent.height - 16px;
                                    text: root.text-edit-buffer;
                                    font-size: 13px;
                                    color: Theme.primary-text;
                                    wrap: word-wrap;
                                    single-line: false;
                                    edited => { root.text-edit-changed(self.text); }
                                    init => { self.focus(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Ctrl+Enter 保存 · Esc 取消";
                                    font-size: 11px;
                                    color: Theme.muted-text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.text-edit-cancel(); }
                                    Text { text: "取消"; font-size: 12px; color: Theme.secondary-text; }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.text-edit-save(); }
                                    Text { text: "保存"; font-size: 12px; color: Theme.accent; }
                                }
                            }
                        }
                    }
                }
            }
            }
        }
    }
}
}

// ===== 系统托盘 =====
export component TrayIcon inherits SystemTrayIcon {
    in-out property <image> glyph: @image-url("../assets/tray.png");
    icon: root.glyph;
    in property <string> tip-text: "clipx";
    tooltip: root.tip-text;
    in property <string> autostart-label: "开机自启：未知";
    in property <string> auto-update-label: "自动更新：关";
    in property <string> pause-label: "暂停采集";
    in property <string> clear-label: "清空历史";
    in property <string> about-label: "关于 clipx";

    callback tray-toggle();
    callback tray-pause();
    callback tray-clear();
    callback tray-autostart();
    callback tray-filejump();
    callback tray-settings();
    callback tray-quit();
    callback tray-probe();
    callback tray-about();
    callback tray-update();
    callback tray-install-update();
    callback tray-auto-update();
    callback tray-export();
    callback tray-import();

    clicked => { root.tray-toggle(); }

    Menu {
        MenuItem {
            title: "显示 / 隐藏";
            activated => { root.tray-toggle(); }
        }
        MenuItem {
            title: root.pause-label;
            activated => { root.tray-pause(); }
        }
        MenuItem {
            title: root.clear-label;
            activated => { root.tray-clear(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "文件夹跳转";
            activated => { root.tray-filejump(); }
        }
        MenuItem {
            title: "设置";
            activated => { root.tray-settings(); }
        }
        MenuItem {
            title: root.autostart-label;
            activated => { root.tray-autostart(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "探测文件对话框";
            activated => { root.tray-probe(); }
        }
        MenuItem {
            title: "导出历史…";
            activated => { root.tray-export(); }
        }
        MenuItem {
            title: "导入历史…";
            activated => { root.tray-import(); }
        }
        MenuItem {
            title: "检查更新";
            activated => { root.tray-update(); }
        }
        MenuItem {
            title: "下载并安装更新";
            activated => { root.tray-install-update(); }
        }
        MenuItem {
            title: root.auto-update-label;
            activated => { root.tray-auto-update(); }
        }
        MenuItem {
            title: root.about-label;
            activated => { root.tray-about(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "退出";
            activated => { root.tray-quit(); }
        }
    }
}
