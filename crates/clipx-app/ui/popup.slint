import { Theme } from "theme.slint";
import { UiPill, UiIconBtn } from "widgets.slint";
import { IconMark, IconClipboard, IconSearch } from "icons.slint";

// 再导出快速查找窗口与 FileJump 窗口（本文件是唯一 slint 编译入口）
export { QuickFindWindow, QfRow } from "quickfind.slint";
export { FileJumpWindow, FjRow } from "filejump.slint";
export { SettingsWindow } from "settings.slint";
export { Theme } from "theme.slint";

export struct RowData {
    id: int,
    kind: int,
    icon: string,
    index-label: string,
    preview: string,
    hit-pre: string,
    hit: string,
    hit-post: string,
    sub: string,
    time-ago: string,
    thumb: image,
    idx: int,
    picked: bool,
    current: bool,
    pending-delete: bool,
}

export struct MenuRow {
    label: string,
    action: string,
    danger: bool,
    hot: bool,
}

// ===== 菜单条目（右键上下文菜单用）=====
component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> hot: false;
    callback activate();

    height: 36px;
    border-radius: 6px;
        background: root.hot || entry-touch.has-hover ? Theme.selected : transparent;

    entry-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }

    Text {
        x: 12px;
        text: root.label;
        font-size: 13px;
        color: root.danger ? #E06C75 : Theme.primary-text;
        vertical-alignment: center;
    }
}

export component PopupWindow inherits Window {
    in-out property <[RowData]> rows;
    in-out property <int> selected-index: 0;
    /// 仅一行悬停：ListView 里 TouchArea.has-hover 会串到邻行
    in-out property <int> hover-index: -1;
    in-out property <bool> search-active: false;
    in-out property <string> search-text;
    in-out property <string> search-count;
    in-out property <string> type-filter-label: "全部";
    in-out property <string> item-count: "";
    in-out property <string> batch-label: "普通";
    in-out property <string> footer-hint: "Ctrl+N快贴 · ↑↓选择 · Home/End首尾 · PgUp/Dn翻页 · Enter粘贴";
    in-out property <float> list-width-px: 404;
    in-out property <bool> window-pinned: false;
    in-out property <bool> text-edit-open: false;
    in-out property <string> text-edit-buffer: "";

    // ===== 预览模式（Space 切换，对齐 WPF 版条目预览）=====
    in-out property <bool> preview-active: false;
    in-out property <bool> preview-has-image: false;
    in-out property <image> preview-image;
    in-out property <string> preview-text;
    in-out property <string> preview-info: "预览";

    // ===== 右键上下文菜单（Menu 键 / 鼠标右键，M3）=====
    in-out property <bool> menu-visible: false;
    in-out property <int> menu-index: -1;
    in-out property <[MenuRow]> menu-rows;
    in-out property <length> menu-y: 0px;

    // ===== 快捷短语编辑浮层 =====
    in-out property <bool> phrase-edit-open: false;
    in-out property <string> phrase-edit-preview: "";
    in-out property <string> phrase-edit-buffer: "";
    in-out property <float> row-height-px: 40;
    in-out property <float> panel-opacity: 1.0;
    in-out property <int> first-visible: 0;
    /// 切片基址：rows[k] 对应全局行 row-base+k（窗口虚拟化）。
    in-out property <int> row-base: 0;
    /// 全局总行数（滚动条高度/空状态用；rows 只是切片）。
    in-out property <int> total-count: 0;

    callback row-clicked(int);
    callback row-double-clicked(int);
    callback filter-clicked();
    callback batch-clicked();
    /// 批量模式胶囊右键：打开批量菜单（对齐 WPF BatchModeHeader_RightClick）
    callback batch-menu();
    /// 右键某行：请求打开菜单（Slint 侧已设好 menu-y；index 同步选中）
    callback menu-requested(int);
    /// 菜单动作
    callback menu-action(string);
    callback menu-close();
    callback open-settings();
    callback pin-window();
    callback title-drag(length, length);
    callback middle-preview(int);
    /// 滚轮自由滚动：估算首行（全局行号），Rust 侧越界才重切片。
    callback list-scrolled(int);
    callback text-edit-changed(string);
    callback text-edit-save();
    callback text-edit-cancel();
    callback phrase-edit-changed(string);
    callback phrase-edit-save();
    callback phrase-edit-cancel();

    /// 键盘 Menu 键路径：按选中行索引计算菜单 y（右键路径不需要）
    public function menu-position-at(index: int) {
        root.menu-y = Math.max(4px, Math.min(
            index * root.row-height + list.viewport-y,
            list.height - (8px + root.menu-rows.length * 36px)));
    }

    title: "clipx";
    always-on-top: true;
    no-frame: true;
    default-font-family: "Segoe UI";
    // 与 WPF AllowsTransparency 相同：1 级 alpha 保住阴影区域。
    background: #01000000;
    preferred-width: 452px;
    preferred-height: 592px;

    changed selected-index => {
        root.bring-into-view(root.selected-index);
    }
    changed first-visible => {
        list.viewport-y = -root.first-visible * root.row-height;
        list.viewport-y = Math.max(list.viewport-y, Math.min(0, list.height - root.total-count * root.row-height));
        list.viewport-y = Math.min(list.viewport-y, 0);
    }
    // 视口镜像：Flickable 原生滚轮不经过 Rust，用绑定观察视口变化，
    // 估算首行越过切片边距才上报（程序化定位落在窗口内，保持静默防回环）。
    property <length> viewport-mirror: list.viewport-y;
    changed viewport-mirror => {
        if (root.total-count > 0 && root.rows.length > 0
            && (Math.round(-root.viewport-mirror / root.row-height) < root.row-base + 8
                || Math.round(-root.viewport-mirror / root.row-height) + 24 > root.row-base + root.rows.length)) {
            root.list-scrolled(Math.max(0, Math.min(Math.round(-root.viewport-mirror / root.row-height), root.total-count - 1)));
        }
    }

    private property <length> row-height: root.row-height-px * 1px;
    private property <bool> help-open: false;

    public function bring-into-view(index: int) {
        if (index < 0 || root.total-count == 0) {
            return;
        }
        // 项的视口内 y = index*row-height + viewport-y
        if (index * root.row-height + list.viewport-y < 0) {
            list.viewport-y = -index * root.row-height;
        }
        if ((index + 1) * root.row-height + list.viewport-y > list.height) {
            list.viewport-y = list.height - (index + 1) * root.row-height;
        }
        // 夹紧滚动范围
        list.viewport-y = Math.max(list.viewport-y, Math.min(0, list.height - root.total-count * root.row-height));
        list.viewport-y = Math.min(list.viewport-y, 0);
    }

    // 阴影画在卡片外：外层不能 clip。软件渲染的 drop-shadow 经常看不见，补一层假阴影。
    Rectangle {
        x: 20px;
        y: 22px;
        width: parent.width - 40px;
        height: parent.height - 38px;
        border-radius: 14px;
        background: #55000000;
    }
    Rectangle {
        x: 16px;
        y: 16px;
        width: parent.width - 32px;
        height: parent.height - 32px;
        border-radius: 12px;
        background: Theme.popup-bg;
        border-width: 1px;
        border-color: Theme.border;
        opacity: root.panel-opacity;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #80000000;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 12px;
            clip: true;

        HorizontalLayout {
            padding: 0;
            spacing: 0;

            list-col := VerticalLayout {
                // 无预览铺满卡片；固定 list-width-px 会比卡片更宽，顶栏/底栏被 clip 后贴边。
                width: root.preview-active ? root.list-width-px * 1px : parent.width;
                padding: 0;
                spacing: 0;

            // ===== 头部：标题 + 计数 + 类型筛选 =====
            Rectangle {
                height: 44px;
                background: Theme.popup-bg;
                header-drag := TouchArea {
                    mouse-cursor: move;
                    property <bool> dragging: false;
                    property <length> press-x;
                    property <length> press-y;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            press-x = self.mouse-x;
                            press-y = self.mouse-y;
                            dragging = true;
                        }
                        if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            dragging = false;
                        }
                    }
                    moved => {
                        if (dragging) {
                            root.title-drag(self.mouse-x - press-x, self.mouse-y - press-y);
                        }
                    }
                }
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 11px;
                    padding-bottom: 11px;
                    spacing: 0;

                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 0;
                        Rectangle {
                            width: 14px;
                            height: 22px;
                            IconClipboard {
                                y: 3px;
                                fill: Theme.secondary-text;
                            }
                        }
                        Text {
                            text: "剪切板历史";
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.primary-text;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.item-count;
                            font-size: 12px;
                            color: Theme.secondary-text;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    HorizontalLayout {
                        spacing: 0;
                        horizontal-stretch: 0;
                        UiPill {
                            text: root.batch-label;
                            filled: true;
                            clicked => { root.batch-clicked(); }
                            right-clicked => { root.batch-menu(); }
                        }
                        Rectangle { width: 8px; }
                        UiIconBtn {
                            kind: 0;
                            on: root.window-pinned;
                            clicked => { root.pin-window(); }
                        }
                        Rectangle { width: 4px; }
                        UiIconBtn {
                            kind: 1;
                            clicked => { root.open-settings(); }
                        }
                        Rectangle { width: 8px; }
                        UiPill {
                            text: root.type-filter-label;
                            clicked => { root.filter-clicked(); }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: Theme.border;
                }
            }

            // ===== 搜索栏（搜索时显示）=====
            if root.search-active: Rectangle {
                height: 40px;
                Rectangle {
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    height: 28px;
                    border-radius: 8px;
                    background: Theme.input-bg;
                    border-width: 1px;
                    border-color: Theme.accent;
                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 14px;
                            height: 100%;
                            IconSearch {
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        Text {
                            text: root.search-text;
                            font-size: 13px;
                            color: Theme.primary-text;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.search-count;
                            font-size: 11px;
                            color: Theme.secondary-text;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ===== 列表 / 空状态 =====
            Rectangle {
                vertical-stretch: 1;

                list := Flickable {
                    x: 6px;
                    width: parent.width - 12px;
                    y: 0;
                    height: parent.height;
                    viewport-height: root.total-count * root.row-height;

                    VerticalLayout {
                        width: 100%;
                        alignment: start;
                        spacing: 0px;

                    // 切片顶部占位：把切片行顶到全局位置（虚拟化）。
                    if root.row-base > 0: Rectangle {
                        width: 100%;
                        height: root.row-base * root.row-height;
                    }
                    for row[index] in root.rows: row-rect := Rectangle {
                        width: 100%;
                        height: root.row-height;
                        clip: true;
                        opacity: row.pending-delete ? 0.55 : 1.0;

                        row-touch := TouchArea {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            double-clicked => { root.row-double-clicked(index); }
                            moved => { root.hover-index = index; }
                            changed has-hover => {
                                if (!row-touch.has-hover && root.hover-index == index) {
                                    root.hover-index = -1;
                                }
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    root.row-clicked(index);
                                }
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                    root.menu-y = Math.max(4px, Math.min(
                                        row-rect.y + list.viewport-y,
                                        list.height - 260px));
                                    root.menu-requested(index);
                                }
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.middle) {
                                    root.middle-preview(index);
                                }
                            }
                        }

                        Rectangle {
                            x: 2px;
                            y: 1px;
                            width: parent.width - 4px;
                            height: parent.height - 2px;
                            border-radius: 6px;
                            background: row.picked
                                ? Theme.selected
                                : (root.hover-index == index ? Theme.hover : transparent);

                            if row.current: Rectangle {
                                x: 0px;
                                y: 6px;
                                width: 3px;
                                height: parent.height - 12px;
                                border-radius: 2px;
                                background: Theme.accent;
                            }

                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;

                                Text {
                                    width: 14px;
                                    height: 100%;
                                    text: row.index-label;
                                    font-size: 10px;
                                    color: Theme.muted-text;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 4px;
                                    background: row.kind == 1 ? Theme.surface : transparent;
                                    clip: true;
                                    if row.kind == 1: Image {
                                        width: 100%;
                                        height: 100%;
                                        source: row.thumb;
                                        image-fit: cover;
                                    }
                                    if row.kind != 1: IconMark {
                                        kind: row.kind;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 1px;
                                    HorizontalLayout {
                                        spacing: 0px;
                                        alignment: start;
                                        if row.hit == "": Text {
                                            text: row.preview;
                                            font-size: 13px;
                                            color: Theme.primary-text;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if row.hit != "" && row.hit-pre != "": Text {
                                            text: row.hit-pre;
                                            font-size: 13px;
                                            color: Theme.primary-text;
                                            vertical-alignment: center;
                                            horizontal-stretch: 0;
                                        }
                                        if row.hit != "": Text {
                                            text: row.hit;
                                            font-size: 13px;
                                            color: Theme.accent;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            horizontal-stretch: 0;
                                        }
                                        if row.hit != "": Text {
                                            text: row.hit-post;
                                            font-size: 13px;
                                            color: Theme.primary-text;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    if row.sub != "": Text {
                                        text: row.sub;
                                        font-size: 10px;
                                        color: Theme.muted-text;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    height: 100%;
                                    text: row.time-ago;
                                    font-size: 11px;
                                    color: Theme.secondary-text;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                    }
                }

                if root.total-count == 0: Rectangle {
                    background: Theme.popup-bg;
                    if root.search-active: VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "🔍";
                            font-size: 28px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "无匹配结果";
                            font-size: 13px;
                            color: Theme.secondary-text;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "可试拼音全拼或首字母，如「nihao」「nh」";
                            font-size: 11px;
                            color: Theme.muted-text;
                            horizontal-alignment: center;
                        }
                    }
                    if !root.search-active: VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "📭";
                            font-size: 28px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "暂无剪切板记录";
                            font-size: 13px;
                            color: Theme.secondary-text;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "复制一些文本即可开始";
                            font-size: 11px;
                            color: Theme.muted-text;
                            horizontal-alignment: center;
                        }
                    }
                }

                // ===== 右键上下文菜单浮层（列表容器坐标系，z 序最上）=====
                if root.menu-visible: Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                // 点击菜单外任意处关闭（吃掉点击，不落到行上）
                menu-shield := TouchArea {
                    clicked => {
                        root.menu-visible = false;
                        root.menu-close();
                    }
                }

                    Rectangle {
                    x: 72px;
                    y: root.menu-y;
                    width: 268px;
                    height: 8px + root.menu-rows.length * 36px;
                    border-radius: 10px;
                    background: Theme.popup-bg;
                    border-width: 1px;
                    border-color: Theme.border;
                    drop-shadow-blur: 12px;
                    drop-shadow-offset-y: 2px;
                    drop-shadow-color: #90000000;

                    VerticalLayout {
                        padding: 4px;
                        spacing: 0;

                        for item in root.menu-rows: MenuEntry {
                            label: item.label;
                            danger: item.danger;
                            hot: item.hot;
                            activate => {
                                root.menu-visible = false;
                                root.menu-action(item.action);
                            }
                        }
                    }
                }
            }
            }

            // ===== 底部提示栏 =====
            Rectangle {
                height: 36px;
                background: Theme.footer-bg;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    Text {
                        text: root.footer-hint;
                        font-size: 10px;
                        color: Theme.muted-text;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        height: 20px;
                        vertical-stretch: 0;
                        border-radius: 10px;
                        background: Theme.accent;
                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            Text {
                                text: "more";
                                font-size: 10px;
                                font-weight: 600;
                                color: Theme.on-accent;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.help-open = !root.help-open; }
                        }
                    }
                }
            }
            }

            if root.preview-active: Rectangle {
                width: 1px;
                background: Theme.border;
            }

            if root.preview-active: Rectangle {
                horizontal-stretch: 1;
                background: Theme.window-bg;
                clip: true;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: root.preview-info;
                        font-size: 11px;
                        color: Theme.secondary-text;
                        overflow: elide;
                    }

                    if root.preview-has-image: Rectangle {
                        vertical-stretch: 1;
                        border-radius: 8px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;
                        Image {
                            source: root.preview-image;
                            width: parent.width;
                            height: parent.height;
                            image-fit: contain;
                        }
                    }

                    if root.preview-text != "": Rectangle {
                        height: root.preview-has-image ? 120px : 0px;
                        vertical-stretch: root.preview-has-image ? 0 : 1;
                        border-radius: 8px;
                        background: Theme.surface;
                        clip: true;
                        preview-flick := Flickable {
                            width: 100%;
                            height: 100%;
                            preview-text-col := Text {
                                x: 10px;
                                y: 10px;
                                width: preview-flick.width - 20px;
                                text: root.preview-text;
                                font-size: 12px;
                                color: Theme.primary-text;
                                wrap: word-wrap;
                            }
                            viewport-height: preview-text-col.y + preview-text-col.height + 10px;
                        }
                    }

                    Text {
                        text: "Space 关闭预览";
                        font-size: 10px;
                        color: Theme.muted-text;
                    }
                }
        }

        if root.help-open: Rectangle {
            width: 100%;
            height: 100%;
            TouchArea { clicked => { root.help-open = false; } }
            Rectangle {
                x: parent.width - 340px;
                y: parent.height - 280px;
                width: 308px;
                height: 248px;
                border-radius: 10px;
                background: Theme.popup-bg;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: #73000000;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    Text {
                        text: "快捷键";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.primary-text;
                    }
                    Text {
                        text: "主键+N 快贴当前可见序号\n↑↓ 选择  ·  ←→ / PgUp/Dn 翻页  ·  Home/End 首尾\nEnter 粘贴（多选=连贴/合并）  ·  Ctrl+Enter 每条换行\nShift+Enter 粘贴图片 OCR 文字\nTab 筛选类型  ·  主键+Tab 仅看短语\na-z 拼音搜索  ·  Space/中键 预览（多图文件 ←→ 切图）\nShift+↑↓ / Shift+单击 连选  ·  Ctrl+单击 加减\nDel×2 删除  ·  Alt 菜单（FIFO/LIFO 或队列非空时为批量菜单）\nEsc 关菜单/预览/搜索/面板";
                        font-size: 12px;
                        color: Theme.secondary-text;
                        wrap: word-wrap;
                    }
                }
            }
        }

        if root.phrase-edit-open: Rectangle {
            width: 100%;
            height: 100%;
            background: #80000000;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 320px;
                        border-radius: 10px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text {
                                text: "设为快捷短语";
                                font-size: 14px;
                                color: Theme.primary-text;
                            }
                            Text {
                                text: root.phrase-edit-preview;
                                font-size: 12px;
                                color: Theme.secondary-text;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                height: 36px;
                                border-radius: 8px;
                                background: Theme.window-bg;
                                border-width: 1px;
                                border-color: Theme.accent;
                                phrase-inp := TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: 100%;
                                    text: root.phrase-edit-buffer;
                                    font-size: 13px;
                                    color: Theme.primary-text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    edited => { root.phrase-edit-changed(self.text); }
                                    init => { self.focus(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Enter 确认 · Esc 取消";
                                    font-size: 11px;
                                    color: Theme.muted-text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.phrase-edit-cancel(); }
                                    Text { text: "取消"; font-size: 12px; color: Theme.secondary-text; }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.phrase-edit-save(); }
                                    Text { text: "保存"; font-size: 12px; color: Theme.accent; }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.text-edit-open: Rectangle {
            width: 100%;
            height: 100%;
            background: #80000000;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 360px;
                        border-radius: 10px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text {
                                text: "编辑文本";
                                font-size: 14px;
                                color: Theme.primary-text;
                            }
                            Rectangle {
                                height: 160px;
                                border-radius: 8px;
                                background: Theme.window-bg;
                                border-width: 1px;
                                border-color: Theme.accent;
                                edit-inp := TextInput {
                                    x: 10px;
                                    y: 8px;
                                    width: parent.width - 20px;
                                    height: parent.height - 16px;
                                    text: root.text-edit-buffer;
                                    font-size: 13px;
                                    color: Theme.primary-text;
                                    wrap: word-wrap;
                                    single-line: false;
                                    edited => { root.text-edit-changed(self.text); }
                                    init => { self.focus(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Ctrl+Enter 保存 · Esc 取消";
                                    font-size: 11px;
                                    color: Theme.muted-text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.text-edit-cancel(); }
                                    Text { text: "取消"; font-size: 12px; color: Theme.secondary-text; }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.text-edit-save(); }
                                    Text { text: "保存"; font-size: 12px; color: Theme.accent; }
                                }
                            }
                        }
                    }
                }
            }
            }
        }
    }
}
}

// ===== 系统托盘 =====
export component TrayIcon inherits SystemTrayIcon {
    in-out property <image> glyph: @image-url("../assets/tray.png");
    icon: root.glyph;
    in property <string> tip-text: "clipx";
    tooltip: root.tip-text;
    in property <string> autostart-label: "开机自启：未知";
    in property <string> pause-label: "暂停采集";
    in property <string> clear-label: "清空历史";
    in property <string> about-label: "关于 clipx";

    callback tray-toggle();
    callback tray-pause();
    callback tray-clear();
    callback tray-autostart();
    callback tray-filejump();
    callback tray-settings();
    callback tray-quit();
    callback tray-probe();
    callback tray-about();
    callback tray-update();
    callback tray-export();
    callback tray-import();

    clicked => { root.tray-toggle(); }

    Menu {
        MenuItem {
            title: "显示 / 隐藏";
            activated => { root.tray-toggle(); }
        }
        MenuItem {
            title: root.pause-label;
            activated => { root.tray-pause(); }
        }
        MenuItem {
            title: root.clear-label;
            activated => { root.tray-clear(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "文件夹跳转";
            activated => { root.tray-filejump(); }
        }
        MenuItem {
            title: "设置";
            activated => { root.tray-settings(); }
        }
        MenuItem {
            title: root.autostart-label;
            activated => { root.tray-autostart(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "探测文件对话框";
            activated => { root.tray-probe(); }
        }
        MenuItem {
            title: "导出历史…";
            activated => { root.tray-export(); }
        }
        MenuItem {
            title: "导入历史…";
            activated => { root.tray-import(); }
        }
        MenuItem {
            title: "检查更新";
            activated => { root.tray-update(); }
        }
        MenuItem {
            title: root.about-label;
            activated => { root.tray-about(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "退出";
            activated => { root.tray-quit(); }
        }
    }
}
