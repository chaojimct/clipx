import { Theme } from "theme.slint";
import { UiSection, UiBtn, UiToggle, UiScroll } from "widgets.slint";

export struct PluginCard {
    name: string,
    desc: string,
    status: string,
    enabled: bool,
    has_toggle: bool,
    toggle: string,
    // 圆点语义（注册侧定）：ok 正常 / off 已关停 / warn 待处理。
    dot: string,
}

// 左右结构（2026-11-02）：左侧插件导航，右侧详情/配置。
// 拓展包不住单列——收进各自插件详情的「关联拓展包」区（`detail-pack-*`）。
// 后续新插件只加行；新配置行挂右侧「配置」区，数据走 PluginInfo 加字段。
export component PluginWindow inherits Window {
    title: "clipx 插件";
    icon: @image-url("../assets/tray.png");

    in-out property <[PluginCard]> plugin-rows;
    in-out property <int> selected;

    in property <string> detail-title;
    in property <string> detail-desc;
    in property <string> detail-state;
    in property <bool> detail-is-plugin;
    in property <bool> detail-has-toggle;
    in property <bool> detail-toggle-on;
    in property <string> detail-toggle-target;
    in property <bool> detail-has-btn;
    in property <string> detail-btn-label;
    in property <bool> detail-btn-is-url;
    in property <string> detail-btn-target;
    in property <string> detail-note;
    in property <bool> detail-has-pack;
    in property <string> detail-pack-name;
    in property <string> detail-pack-desc;
    in property <string> detail-pack-state;
    in property <bool> detail-pack-has-btn;
    in property <string> detail-pack-btn-label;
    in property <bool> detail-pack-btn-is-url;
    in property <string> detail-pack-btn-target;
    in property <string> detail-pack-note;

    callback plugin-select(int);
    callback plugin-toggle(string);
    callback pack-download(string);
    callback open-url(string);
    callback plugin-close();

    min-width: 760px;
    min-height: 620px;
    background: Theme.window-bg;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "插件";
                font-size: 17px;
                font-weight: 700;
                color: Theme.primary-text;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            UiBtn { text: "关闭"; clicked => { root.plugin-close(); } }
        }

        Text {
            text: "左侧选插件，右侧看详情；开关拨动即时生效，下载进度走右下角提示条。";
            font-size: 11px;
            color: Theme.muted-text;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            // ===== 左侧导航（6 行常驻，无需滚；条目只增不改结构）=====
            Rectangle {
                width: 236px;
                clip: true;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.card-bg;
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    UiSection { text: "功能插件"; }
                    for card[idx] in root.plugin-rows: Rectangle {
                        border-radius: 8px;
                        background: root.selected == idx ? Theme.selected : transparent;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected = idx;
                                root.plugin-select(idx);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 9px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                // HorizontalLayout 子元素无垂直居中，按父行高算 y。
                                y: (parent.height - self.height) / 2;
                                background: card.dot == "ok" ? Theme.accent : card.dot == "warn" ? Theme.highlight : Theme.muted-text;
                            }
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: card.name;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.primary-text;
                                }
                                Text {
                                    text: card.status;
                                    font-size: 11px;
                                    // 选中行小字也提亮（浅色主题下 muted 在选中底上发虚）。
                                    color: root.selected == idx ? Theme.primary-text : Theme.muted-text;
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        text: "共 \{root.plugin-rows.length} 个插件";
                        font-size: 11px;
                        color: Theme.muted-text;
                    }
                }
            }

            // ===== 右侧详情/配置（随配置行增多可滚；与设置页同构 Rectangle 包 scroll）=====
            // UiScroll 内部 height:100%：必须放在普通 Rectangle 里撑满剩余区，
            // 直接放 Layout 里会被撑成整窗高导致滚不动（2026-11-02 旧布局的坑）。
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.card-bg;
                UiScroll {
                    Text {
                        text: root.detail-title;
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.primary-text;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.detail-desc;
                        font-size: 12px;
                        color: Theme.muted-text;
                        wrap: word-wrap;
                    }
                    UiSection { text: "状态"; }
                    Text {
                        text: root.detail-state;
                        font-size: 12px;
                        color: Theme.secondary-text;
                        wrap: word-wrap;
                    }
                    UiSection { text: "配置"; }
                    if root.detail-is-plugin && root.detail-has-toggle: Rectangle {
                        border-radius: 8px;
                        background: Theme.window-bg;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            Text {
                                text: "启用";
                                font-size: 13px;
                                color: Theme.primary-text;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            UiToggle {
                                checked: root.detail-toggle-on;
                                toggled => { root.plugin-toggle(root.detail-toggle-target); }
                            }
                        }
                    }
                    if root.detail-has-btn: Rectangle {
                        border-radius: 8px;
                        background: Theme.window-bg;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            Text {
                                text: "操作";
                                font-size: 13px;
                                color: Theme.primary-text;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            UiBtn {
                                text: root.detail-btn-label;
                                clicked => {
                                    if (root.detail-btn-is-url) {
                                        root.open-url(root.detail-btn-target);
                                    } else {
                                        root.pack-download(root.detail-btn-target);
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.detail-note;
                        font-size: 11px;
                        color: Theme.muted-text;
                        wrap: word-wrap;
                    }
                    if root.detail-has-pack: UiSection { text: "关联拓展包"; }
                    if root.detail-has-pack: Rectangle {
                        border-radius: 8px;
                        background: Theme.window-bg;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text {
                                text: root.detail-pack-name;
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.primary-text;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.detail-pack-desc;
                                font-size: 11px;
                                color: Theme.muted-text;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "状态：" + root.detail-pack-state;
                                    font-size: 11px;
                                    color: Theme.secondary-text;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                if root.detail-pack-has-btn: UiBtn {
                                    text: root.detail-pack-btn-label;
                                    clicked => {
                                        if (root.detail-pack-btn-is-url) {
                                            root.open-url(root.detail-pack-btn-target);
                                        } else {
                                            root.pack-download(root.detail-pack-btn-target);
                                        }
                                    }
                                }
                            }
                            Text {
                                text: root.detail-pack-note;
                                font-size: 11px;
                                color: Theme.muted-text;
                                wrap: word-wrap;
                            }
                        }
                    }
                    }
                }
            }
        }
    }
