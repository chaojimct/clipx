import { Theme } from "theme.slint";
import { UiSection, UiBtn, UiToggle, UiScroll } from "widgets.slint";

export struct PluginCard {
    name: string,
    desc: string,
    status: string,
    enabled: bool,
    has_toggle: bool,
    toggle: string,
}

export struct PackCard {
    name: string,
    desc: string,
    state: string,
    has_btn: bool,
    btn_label: string,
    is_url: bool,
    target: string,
}

// 左右结构（2026-11-02）：左侧导航（插件 + 拓展包两组），右侧详情/配置。
// 选中是统一序号：0..plugin-count 为插件，其后为拓展包（Rust 侧 clamp + 算详情）。
// 后续新插件只加行；新配置行挂右侧「配置」区，数据走 PluginInfo/PackInfo 加字段。
export component PluginWindow inherits Window {
    title: "clipx 插件";
    icon: @image-url("../assets/tray.png");

    in-out property <[PluginCard]> plugin-rows;
    in-out property <[PackCard]> pack-rows;
    in-out property <int> plugin-count;
    in-out property <int> selected;

    in property <string> detail-title;
    in property <string> detail-desc;
    in property <string> detail-state;
    in property <bool> detail-is-plugin;
    in property <bool> detail-has-toggle;
    in property <bool> detail-toggle-on;
    in property <string> detail-toggle-target;
    in property <bool> detail-has-btn;
    in property <string> detail-btn-label;
    in property <bool> detail-btn-is-url;
    in property <string> detail-btn-target;
    in property <string> detail-note;

    callback plugin-select(int);
    callback plugin-toggle(string);
    callback pack-download(string);
    callback open-url(string);
    callback plugin-close();

    min-width: 760px;
    min-height: 620px;
    background: Theme.window-bg;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "插件";
                font-size: 17px;
                font-weight: 700;
                color: Theme.primary-text;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            UiBtn { text: "关闭"; clicked => { root.plugin-close(); } }
        }

        Text {
            text: "左侧选条目，右侧看详情；开关拨动即时生效，下载进度走右下角提示条。";
            font-size: 11px;
            color: Theme.muted-text;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            // ===== 左侧导航（8 行常驻，无需滚；条目只增不改结构）=====
            Rectangle {
                width: 236px;
                clip: true;
                border-radius: 8px;
                background: Theme.card-bg;
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    UiSection { text: "功能插件"; }
                    for card[idx] in root.plugin-rows: Rectangle {
                        border-radius: 6px;
                        background: root.selected == idx ? Theme.selected : transparent;
                        TouchArea {
                            clicked => {
                                root.selected = idx;
                                root.plugin-select(idx);
                            }
                        }
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 1px;
                            Text {
                                text: card.name;
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.primary-text;
                            }
                            Text {
                                text: card.status;
                                font-size: 11px;
                                color: Theme.muted-text;
                            }
                        }
                    }
                    UiSection { text: "拓展包"; }
                    for pack[idx] in root.pack-rows: Rectangle {
                        border-radius: 6px;
                        background: root.selected == root.plugin-count + idx ? Theme.selected : transparent;
                        TouchArea {
                            clicked => {
                                root.selected = root.plugin-count + idx;
                                root.plugin-select(root.plugin-count + idx);
                            }
                        }
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 1px;
                            Text {
                                text: pack.name;
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.primary-text;
                            }
                            Text {
                                text: pack.state;
                                font-size: 11px;
                                color: Theme.muted-text;
                            }
                        }
                    }
                }
            }

            // ===== 右侧详情/配置（随配置行增多可滚；与设置页同构 Rectangle 包 scroll）=====
            // UiScroll 内部 height:100%：必须放在普通 Rectangle 里撑满剩余区，
            // 直接放 Layout 里会被撑成整窗高导致滚不动（2026-11-02 旧布局的坑）。
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                border-radius: 8px;
                background: Theme.card-bg;
                UiScroll {
                    Text {
                        text: root.detail-title;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.primary-text;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.detail-desc;
                        font-size: 12px;
                        color: Theme.muted-text;
                        wrap: word-wrap;
                    }
                    UiSection { text: "状态"; }
                    Text {
                        text: root.detail-state;
                        font-size: 12px;
                        color: Theme.secondary-text;
                        wrap: word-wrap;
                    }
                    UiSection { text: "配置"; }
                    if root.detail-is-plugin && root.detail-has-toggle: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "启用";
                            font-size: 13px;
                            color: Theme.primary-text;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        UiToggle {
                            checked: root.detail-toggle-on;
                            toggled => { root.plugin-toggle(root.detail-toggle-target); }
                        }
                    }
                    if root.detail-has-btn: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "操作";
                            font-size: 13px;
                            color: Theme.primary-text;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        UiBtn {
                            text: root.detail-btn-label;
                            clicked => {
                                if (root.detail-btn-is-url) {
                                    root.open-url(root.detail-btn-target);
                                } else {
                                    root.pack-download(root.detail-btn-target);
                                }
                            }
                        }
                    }
                    Text {
                        text: root.detail-note;
                        font-size: 11px;
                        color: Theme.muted-text;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
