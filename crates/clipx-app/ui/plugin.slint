import { Theme } from "theme.slint";
import { UiSection, UiRow, UiBtn, UiToggle, UiField, UiChip, UiSlider, UiScroll } from "widgets.slint";

// 左栏导航行（flat 即全序号，点行直接回传，无二次换算）。
export struct NavRow {
    title: string,
    // 圆点：ok/off/warn 上色，"" 不画（设置组）。
    dot: string,
    flat: int,
}

// 通用配置行（Rust section.rs 即数据，kind 分支渲染；全即时语义）。
// kind: toggle 文本框 text 下拉 choice 动作 action 纯文本 info
//       录制 record 滑条 slider 进度 progress
export struct CfgRow {
    label: string,
    help: string,
    kind: string,
    key: string,
    on: bool,
    text: string,
    width: int,
    choice: string,
    action: string,
    danger: bool,
    enabled: bool,
    recording: bool,
    slot: int,
    num: float,
}

// 统一设置窗（三组导航 + 单详情；插件/设置二元对立已取消，见 section.rs）。
export component PluginWindow inherits Window {
    title: "clipx 设置";
    icon: @image-url("../assets/tray.png");

    in-out property <[NavRow]> nav-settings;
    in-out property <[NavRow]> nav-plugins;
    in-out property <[NavRow]> nav-other;
    in-out property <int> selected;

    in property <string> detail-title;
    in property <string> detail-desc;
    in-out property <[CfgRow]> detail-rows;
    // 快捷键录制槽（-1 空闲；overlay 显隐与 chip 武装都看它）。
    in property <int> detail-recording;
    // 短语编辑器（记录与检索组专用块）。
    in property <bool> detail-show-phrases;
    in-out property <[string]> detail-phrase-rows;
    in-out property <int> detail-phrase-index;
    in-out property <string> detail-phrase-trig;
    in-out property <string> detail-phrase-body;
    // 密码库行专属解锁区。
    in property <bool> detail-has-vault;
    in-out property <string> detail-vault-pw;
    // 名下拓展包区（OCR 行 / 密码库行）。
    in property <bool> detail-has-pack;
    in property <string> detail-pack-name;
    in property <string> detail-pack-desc;
    in property <string> detail-pack-state;
    in property <bool> detail-pack-has-btn;
    in property <string> detail-pack-btn-label;
    in property <bool> detail-pack-btn-is-url;
    in property <string> detail-pack-btn-target;
    in property <string> detail-pack-note;

    callback plugin-select(int);
    callback plugin-vault-pw(string);
    callback plugin-vault-unlock();
    callback plugin-vault-lock();
    callback pack-download(string);
    callback open-url(string);
    callback plugin-close();
    callback cfg-bool(string);
    callback cfg-text(string, string);
    callback cfg-choice(string);
    callback cfg-action(string);
    callback cfg-record(int);
    callback cfg-slider(string, float);
    callback plugin-key(string, int, int);
    callback plugin-key-rel(string);
    callback phrase-sel(int);
    callback phrase-add();
    callback phrase-del();
    callback phrase-trig(string);
    callback phrase-body(string);

    min-width: 780px;
    min-height: 620px;
    background: Theme.window-bg;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "设置";
            font-size: 17px;
            font-weight: 700;
            color: Theme.primary-text;
        }

        Text {
            text: "左侧选条目，右侧调；所有改动即时生效并落盘（危险操作二次确认），无需保存。";
            font-size: 11px;
            color: Theme.muted-text;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            // ===== 左侧导航（单行紧凑，免滚动；Flickable 量高 quirks 见 git 历史）=====
            Rectangle {
                width: 236px;
                clip: true;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.card-bg;
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    UiSection { text: "设置"; }
                    for r in root.nav-settings: Rectangle {
                        border-radius: 8px;
                        background: root.selected == r.flat ? Theme.selected : transparent;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected = r.flat;
                                root.plugin-select(r.flat);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 9px;
                            if r.dot != "": Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                // HorizontalLayout 子元素无垂直居中，按父行高算 y。
                                y: (parent.height - self.height) / 2;
                                background: r.dot == "ok" ? Theme.accent : r.dot == "warn" ? Theme.highlight : Theme.muted-text;
                            }
                            Text {
                                text: r.title;
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.primary-text;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    UiSection { text: "插件"; }
                    for r in root.nav-plugins: Rectangle {
                        border-radius: 8px;
                        background: root.selected == r.flat ? Theme.selected : transparent;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected = r.flat;
                                root.plugin-select(r.flat);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 9px;
                            if r.dot != "": Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                y: (parent.height - self.height) / 2;
                                background: r.dot == "ok" ? Theme.accent : r.dot == "warn" ? Theme.highlight : Theme.muted-text;
                            }
                            Text {
                                text: r.title;
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.primary-text;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    UiSection { text: "其他"; }
                    for r in root.nav-other: Rectangle {
                        border-radius: 8px;
                        background: root.selected == r.flat ? Theme.selected : transparent;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected = r.flat;
                                root.plugin-select(r.flat);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 9px;
                            Text {
                                text: r.title;
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.primary-text;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        text: "共 \{root.nav-settings.length + root.nav-plugins.length + root.nav-other.length} 项";
                        font-size: 11px;
                        color: Theme.muted-text;
                    }
                }
            }

            // ===== 右侧详情（单路；组行多可滚）=====
            // UiScroll 内部 height:100%：必须放在普通 Rectangle 里撑满剩余区，
            // 直接放 Layout 里会被撑成整窗高导致滚不动（2026-11-02 旧布局的坑）。
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.card-bg;
                UiScroll {
                    Text {
                        text: root.detail-title;
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.primary-text;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.detail-desc;
                        font-size: 12px;
                        color: Theme.muted-text;
                        wrap: word-wrap;
                    }
                    // ===== 通用配置行（全即时；text/slider 只管改不管刷，防光标抖）=====
                    VerticalLayout {
                        spacing: 6px;
                        for row in root.detail-rows: UiRow {
                            label: row.label;
                            help: row.help;
                            if row.kind == "toggle": UiToggle {
                                checked: row.on;
                                toggled => { root.cfg-bool(row.key); }
                            }
                            if row.kind == "text": UiField {
                                text: row.text;
                                field-width: row.width * 1px;
                                edited(t) => { root.cfg-text(row.key, t); }
                            }
                            if row.kind == "choice": UiChip {
                                text: row.choice;
                                clicked => { root.cfg-choice(row.key); }
                            }
                            if row.kind == "action": UiBtn {
                                text: row.action;
                                danger: row.danger;
                                enabled: row.enabled;
                                clicked => { root.cfg-action(row.key); }
                            }
                            if row.kind == "info": Text {
                                text: row.text;
                                font-size: 12px;
                                color: row.danger ? Theme.danger : Theme.secondary-text;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                            if row.kind == "record": UiChip {
                                text: row.recording ? "按下快捷键… Esc 取消" : row.choice;
                                armed: row.recording;
                                clicked => { root.cfg-record(row.slot); }
                            }
                            if row.kind == "slider": HorizontalLayout {
                                spacing: 10px;
                                sl := UiSlider {
                                    value: row.num;
                                    minimum: 0.4;
                                    maximum: 1.0;
                                    horizontal-stretch: 1;
                                    changed(v) => { root.cfg-slider(row.key, v); }
                                }
                                Text {
                                    text: "\{Math.round(sl.value * 100.0)}%";
                                    width: 40px;
                                    color: Theme.secondary-text;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                }
                            }
                            if row.kind == "progress": Rectangle {
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.border;
                                Rectangle {
                                    width: row.num < 0 ? parent.width : max(0px, parent.width * row.num);
                                    height: parent.height;
                                    border-radius: 3px;
                                    background: row.num < 0 ? Theme.border : Theme.accent;
                                }
                            }
                        }
                    }
                    // ===== 密码库解锁区 =====
                    if root.detail-has-vault: UiSection { text: "解锁"; }
                    if root.detail-has-vault: UiRow {
                        label: "主密码";
                        help: "只进内存解锁，不保存";
                        UiField {
                            text <=> root.detail-vault-pw;
                            password: true;
                            field-width: 190px;
                            edited(t) => { root.plugin-vault-pw(t); }
                        }
                    }
                    if root.detail-has-vault: UiRow {
                        label: "解锁 / 锁定";
                        HorizontalLayout {
                            spacing: 8px;
                            UiBtn { text: "解锁"; clicked => { root.plugin-vault-unlock(); } }
                            UiBtn { text: "锁定"; clicked => { root.plugin-vault-lock(); } }
                        }
                    }
                    // ===== 关联拓展包区 =====
                    if root.detail-has-pack: UiSection { text: "关联拓展包"; }
                    if root.detail-has-pack: Rectangle {
                        border-radius: 8px;
                        background: Theme.window-bg;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text {
                                text: root.detail-pack-name;
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.primary-text;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.detail-pack-desc;
                                font-size: 11px;
                                color: Theme.muted-text;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "状态：" + root.detail-pack-state;
                                    font-size: 11px;
                                    color: Theme.secondary-text;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                if root.detail-pack-has-btn: UiBtn {
                                    text: root.detail-pack-btn-label;
                                    clicked => {
                                        if (root.detail-pack-btn-is-url) {
                                            root.open-url(root.detail-pack-btn-target);
                                        } else {
                                            root.pack-download(root.detail-pack-btn-target);
                                        }
                                    }
                                }
                            }
                            Text {
                                text: root.detail-pack-note;
                                font-size: 11px;
                                color: Theme.muted-text;
                                wrap: word-wrap;
                            }
                        }
                    }
                    // ===== 短语编辑器（记录与检索组专用块）=====
                    if root.detail-show-phrases: UiSection { text: "快捷短语"; }
                    if root.detail-show-phrases: VerticalLayout {
                        spacing: 6px;
                        for p[i] in root.detail-phrase-rows: Rectangle {
                            height: 32px;
                            border-radius: 8px;
                            background: i == root.detail-phrase-index ? Theme.selected : Theme.surface;
                            border-width: 1px;
                            border-color: i == root.detail-phrase-index ? Theme.accent : Theme.border;
                            Text {
                                x: 10px;
                                width: parent.width - 20px;
                                text: p;
                                font-size: 12px;
                                color: Theme.primary-text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { root.phrase-sel(i); } }
                        }
                    }
                    if root.detail-show-phrases: HorizontalLayout {
                        spacing: 8px;
                        UiBtn { text: "新增空短语"; clicked => { root.phrase-add(); } }
                        UiBtn { text: "删除选中"; danger: true; clicked => { root.phrase-del(); } }
                    }
                    if root.detail-show-phrases: UiRow {
                        label: "触发词";
                        UiField { text: root.detail-phrase-trig; field-width: 180px; edited(t) => { root.phrase-trig(t); } }
                    }
                    if root.detail-show-phrases: UiRow {
                        label: "正文";
                        UiField { text: root.detail-phrase-body; field-width: 240px; edited(t) => { root.phrase-body(t); } }
                    }
                }
            }
        }
    }

    // 快捷键录制覆盖层：仅录制期存在（Slint 直收按键，见 settings.slint 同构实现）。
    if root.detail-recording >= 0: rec-scope := FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            root.plugin-key(event.text,
                (event.modifiers.alt ? 1 : 0) + (event.modifiers.control ? 2 : 0)
                + (event.modifiers.shift ? 4 : 0) + (event.modifiers.meta ? 8 : 0),
                event.repeat ? 1 : 0);
            accept
        }
        key-released(event) => {
            root.plugin-key-rel(event.text);
            accept
        }
    }
}
