// Vault 行内钥匙按钮（M2）：登录输入框旁的浮动钥匙 glyph，点即呼出 vault 快选。
//
// 不抢焦点：Rust 侧 show → position → apply_style → position（与主窗同序；
// apply_style 必须在 show 之后，winit 的 show 会重置 EXSTYLE）。
// 首帧残缺同样适用抖尺寸（win_popup::force_full_repaint_before_show）。
// 样式：裸 glyph（无底无边无阴影，悬在输入框边上不挡字）。
// emoji 必须显式写 color（暗色主题下隐形坑，见 CLAUDE.md）。
import { Theme } from "theme.slint";

export component VaultKeyWindow inherits Window {
    callback clicked();

    title: "clipx-vaultkey";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI";
    width: 36px;
    height: 36px;

    key-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: "🔑";
        font-size: 22px;
        color: Theme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
