export component IconRich {
    in property <color> fill: Theme.secondary-text;
    width: 16px;
    height: 14px;
    Text {
        text: "Aa";
        font-size: 11px;
        font-weight: 700;
        color: root.fill;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component IconPhrase {
    in property <color> fill: Theme.accent;
    width: 12px;
    height: 14px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 12;
        viewbox-height: 14;
        fill: root.fill;
        commands: "M 7 0 L 0 8 L 5.2 8 L 4 14 L 12 5.5 L 6.8 5.5 Z";
    }
}

export component IconStar {
    in property <color> fill: Theme.accent;
    width: 12px;
    height: 12px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 12;
        viewbox-height: 12;
        fill: root.fill;
        commands: "M 6 0.4 L 7.6 4.1 L 11.6 4.3 L 8.5 6.8 L 9.5 10.8 L 6 8.7 L 2.5 10.8 L 3.5 6.8 L 0.4 4.3 L 4.4 4.1 Z";
    }
}

// kind: 0 文本 / 1 图片 / 2 文件 / 3 富文本 / 4 短语
export component IconMark {
    in property <int> kind: 0;
    width: 22px;
    height: 22px;
    if root.kind == 0: IconText {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.kind == 1: IconImage {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.kind == 2: IconFolder {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.kind == 3: IconRich {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.kind == 4: IconPhrase {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}
