import { Theme } from "theme.slint";

// 几何图标（不用系统彩色 Emoji，软件渲染下一套色）。

export component IconPin {
    in property <color> fill: Theme.secondary-text;
    width: 14px;
    height: 14px;
    Rectangle {
        x: 4px; y: 0px; width: 6px; height: 2px;
        border-radius: 1px;
        background: root.fill;
    }
    Rectangle {
        x: 5px; y: 1px; width: 4px; height: 8px;
        border-radius: 1px;
        background: root.fill;
    }
    Rectangle {
        x: 2px; y: 8px; width: 10px; height: 2.5px;
        border-radius: 1px;
        background: root.fill;
    }
    Rectangle {
        x: 6.25px; y: 10px; width: 1.5px; height: 4px;
        border-radius: 0.5px;
        background: root.fill;
    }
}

export component IconGear {
    in property <color> fill: Theme.secondary-text;
    in property <color> hole: Theme.popup-bg;
    width: 14px;
    height: 14px;
    Rectangle { x: 6px; y: 0px; width: 2px; height: 3.5px; background: root.fill; }
    Rectangle { x: 6px; y: 10.5px; width: 2px; height: 3.5px; background: root.fill; }
    Rectangle { x: 0px; y: 6px; width: 3.5px; height: 2px; background: root.fill; }
    Rectangle { x: 10.5px; y: 6px; width: 3.5px; height: 2px; background: root.fill; }
    Rectangle {
        x: 3px; y: 3px; width: 8px; height: 8px;
        border-radius: 4px;
        background: root.fill;
    }
    Rectangle {
        x: 5px; y: 5px; width: 4px; height: 4px;
        border-radius: 2px;
        background: root.hole;
    }
}

export component IconSearch {
    in property <color> fill: Theme.muted-text;
    width: 14px;
