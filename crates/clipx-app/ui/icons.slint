export component IconImage {
    in property <color> fill: Theme.secondary-text;
    width: 16px;
    height: 12px;
    Rectangle {
        x: 0px; y: 0px; width: 16px; height: 12px;
        border-radius: 2px;
        border-width: 1.4px;
        border-color: root.fill;
        background: transparent;
    }
    Rectangle {
        x: 2px; y: 7px; width: 5px; height: 3px;
        background: root.fill;
    }
    Rectangle {
        x: 5px; y: 5px; width: 9px; height: 5px;
        background: root.fill;
    }
