        border-radius: 5px;
        border-width: 1.6px;
        border-color: root.fill;
        background: transparent;
    }
    Rectangle {
        x: 8px; y: 8px; width: 5px; height: 2px;
        border-radius: 1px;
        background: root.fill;
    }
}

