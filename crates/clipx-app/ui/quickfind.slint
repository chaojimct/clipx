import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconFolder, IconFile } from "icons.slint";
import { UiCardShadow, UiScrollBar } from "widgets.slint";

// ===== Explorer 内 Everything 快速查找浮层（对齐 WPF ExplorerQuickFindWindow）=====

export struct QfRow {
    full-path: string,
    name-pre: string,
    name-hit: string,
    name-post: string,
    rel: string,
    is-folder: bool,
    is-global: bool,
    index-label: string,
}

export component QuickFindWindow inherits Window {
    in-out property <[QfRow]> rows;
    in-out property <int> selected-index: 0;
    in-out property <string> folder-label: "全盘";
    in-out property <string> typing-text: " ";
    in-out property <string> count-label;
    in-out property <string> hint-label: "↑↓ 选择 · ←→ 翻页 · Ctrl+N 快选 · Enter 定位 · Esc 关闭";

    callback row-activated(int);

    public function bring-into-view(index: int) {
        if (index < 0 || root.rows.length == 0) {
            return;
        }
        if (index * root.row-height + list.viewport-y < 0) {
            list.viewport-y = -index * root.row-height;
        }
        if ((index + 1) * root.row-height + list.viewport-y > list.visible-height) {
            list.viewport-y = list.visible-height - (index + 1) * root.row-height;
        }
        list.viewport-y = Math.max(list.viewport-y, Math.min(0, list.visible-height - root.rows.length * root.row-height));
        list.viewport-y = Math.min(list.viewport-y, 0);
    }

    changed selected-index => {
        root.bring-into-view(root.selected-index);
    }

    title: "clipx-quickfind";
    always-on-top: true;
    no-frame: true;
    default-font-family: "Segoe UI";
    // 注意 Slint 的 8 位十六进制是 #RRGGBBAA，不是 WPF 的 #AARRGGBB
    background: #00000001;
    preferred-width: 440px;
    preferred-height: 240px;

    private property <length> row-height: 28px;

    // 此前只有死属性 drop-shadow-*，没有任何可见投影
    UiCardShadow {
        card-radius: 12px;
    }
    Rectangle {
        x: 16px;
        y: 16px;
        width: parent.width - 32px;
        height: parent.height - 32px;
        // WPF ExplorerQuickFindWindow 的 MainBorder 同样是 CornerRadius=12
        border-radius: 12px;
        // 与另两个浮窗一致：用带约 5% 透明的 card-bg（= WPF PopupBgBrush ARGB(0xF2,...)）
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.border;
        // 死属性（软件渲染器忽略 drop-shadow-*），颜色按 Slint 顺序修正
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;

        Rectangle {
            width: 100%;
            height: 100%;
            // 与卡片同半径（原来 8px 与卡片的 12px 不一致，圆角处会露边）
            border-radius: 12px;
            clip: true;

        VerticalLayout {
            padding: 0;
            spacing: 0;

            Rectangle {
                height: 32px;
                // 同另两个浮窗：表头透明，卡片圆角才不会被方形的 clip 填平
                background: transparent;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    // 内缩对齐另两个浮窗的表头（WPF 表头 Margin 水平 16）
                    padding-left: 16px;
                    padding-right: 16px;
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        Text {
                            text: "everything";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.primary-text;
                            opacity: 0.7;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.count-label;
                        font-size: 12px;
                        color: Theme.secondary-text;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                }
            }

            // WPF 用的是 ThemeSeparator（比 ThemeBorder 浅一档）
            Rectangle { height: 1px; background: Theme.separator; }

            Rectangle {
                height: 56px;
                Rectangle {
                    x: 10px;
                    y: 4px;
                    width: parent.width - 20px;
                    height: 48px;
                    border-radius: 8px;
                    background: Theme.input-bg;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 1px;
                        Text {
                            text: root.folder-label;
                            font-size: 11px;
                            color: Theme.secondary-text;
                            overflow: elide;
                        }
                        Text {
                            text: root.typing-text;
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.accent;
                            overflow: elide;
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                // 滚动条两把尺子（内容溢出才显示滑块）
                property <length> list-content-h: root.rows.length * root.row-height;
                property <length> list-avail-h: Math.max(0px, self.list-content-h - list.visible-height);

                list := ListView {
                    x: 6px;
                    // 右侧让出 12px 给滚动条轨道
                    width: parent.width - 18px;
                    y: 0;
                    height: root.rows.length == 0 ? 0px : parent.height;
                    viewport-height: root.rows.length * root.row-height;

                    for row[index] in root.rows: row-rect := Rectangle {
                        width: parent.width;
                        height: root.row-height;
                        clip: true;
                        // 是否铺了底色（选中/悬停）；命中高亮据此换色，否则青字压青底
                        property <bool> filled: index == root.selected-index
                            || row-touch.has-hover;

                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.row-activated(index); }
                        }

                        Rectangle {
                            x: 2px;
                            y: 1px;
                            width: parent.width - 4px;
                            height: parent.height - 2px;
                            border-radius: 6px;
                            background: row-rect.filled
                                ? (index == root.selected-index ? Theme.selected : Theme.hover)
                                : transparent;
                            // 选中/悬停淡入淡出，方向键扫过时不再硬闪
                            animate background { duration: 110ms; easing: ease-out; }

                            if index == root.selected-index: Rectangle {
                                x: 0px;
                                y: 6px;
                                width: 3px;
                                height: parent.height - 12px;
                                border-radius: 2px;
                                background: Theme.accent;
                            }

                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: start;

                                Text {
                                    width: 14px;
                                    height: 100%;
                                    text: row.index-label;
                                    font-size: 10px;
                                    color: Theme.muted-text;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                                Rectangle {
                                    width: 18px;
                                    height: 100%;
                                    if row.is-folder: IconFolder {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    if !row.is-folder: IconFile {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                HorizontalLayout {
                                    horizontal-stretch: 0;
                                    spacing: 0px;
                                    alignment: start;
                                    Text {
                                        text: row.name-pre;
                                        font-size: 13px;
                                        color: Theme.primary-text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                    Text {
                                        text: row.name-hit;
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: row-rect.filled
                                            ? Theme.highlight-on-fill
                                            : Theme.highlight;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                    Text {
                                        text: row.name-post;
                                        font-size: 13px;
                                        color: Theme.primary-text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                }
                                if row.rel == "": Rectangle { horizontal-stretch: 1; }
                                if row.rel != "": Text {
                                    text: row.rel;
                                    font-size: 11px;
                                    color: Theme.muted-text;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if row.is-global: Text {
                                    text: "全盘";
                                    font-size: 10px;
                                    color: Theme.muted-text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                            }
                        }
                    }
                }

                // 自绘滚动条：内容溢出才显示（progress 是只读输入，拖动只回发 scrubbed）
                UiScrollBar {
                    x: parent.width - 12px;
                    y: 0;
                    height: parent.height;
                    content-height: list-content-h;
                    view-height: list.visible-height;
                    progress: list-avail-h <= 0px
                        ? 0.0
                        : Math.min(1.0, ((-list.viewport-y) / 1px) / (list-avail-h / 1px));
                    scrubbed(p) => {
                        list.viewport-y = -(p * list-avail-h);
                    }
                }

                if root.rows.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: root.hint-label;
                        font-size: 13px;
                        color: Theme.secondary-text;
                        horizontal-alignment: center;
                        overflow: elide;
                        width: parent.width - 24px;
                    }
                }
            }

            Rectangle {
                height: 32px;
                background: Theme.footer-bg;
                // 底栏与卡片不同色，自带下两角圆角（原因同表头）
                border-bottom-left-radius: 12px;
                border-bottom-right-radius: 12px;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text {
                        text: "↑↓ 选择  ·  Enter 定位  ·  Esc 关闭";
                        font-size: 10px;
                        color: Theme.muted-text;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
        }
    }
}
