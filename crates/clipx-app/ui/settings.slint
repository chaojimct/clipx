import { Theme } from "theme.slint";
import { UiSection, UiRow, UiBtn, UiChip, UiField, UiToggle, UiSlider, UiTab, UiScroll } from "widgets.slint";

export component SettingsWindow inherits Window {
    in-out property <string> num-max-items: "2000";
    in-out property <string> num-max-images: "150";
    in-out property <string> rec-main: "Ctrl+`";
    in-out property <string> rec-batch: "Alt+/";
    in-out property <string> theme-label: "跟随系统";
    in-out property <string> pos-label: "光标处";
    in-out property <string> hide-label: "任意点击隐藏";
    in-out property <float> opacity-val: 1.0;
    in-out property <string> opacity-label: "100%";
    in-out property <string> num-preview-lines: "2";
    in-out property <string> paste-label: "Ctrl+V";
    in-out property <string> panel-label: "Ctrl";
    in-out property <string> rec-pgup: "Ctrl+-";
    in-out property <string> rec-pgdn: "Ctrl+=";
    in-out property <string> num-width: "420";
    in-out property <string> num-maxheight: "560";
    in-out property <string> num-pageitems: "8";
    in-out property <bool> opt-startup;
    in-out property <bool> opt-admin;
    in-out property <bool> opt-updates;
    // 两个更新开关现在集中在「关于」页的「更新」区（原在「常规」页，用户找不到）
    in-out property <bool> opt-autoupdate;
    in-out property <bool> opt-winv;
    in-out property <bool> opt-merge;
    in-out property <bool> opt-autooff;
    in-out property <bool> opt-dblclick;
    in-out property <bool> opt-touch;
    in-out property <bool> opt-clearexit;
    in-out property <bool> opt-ocr;
    in-out property <string> ocr-engine-label: "自动";
    in-out property <bool> opt-simulate;
    in-out property <bool> opt-fj;
    in-out property <bool> opt-deep;
    in-out property <bool> clear-armed: false;
    in-out property <string> clear-label: "清空所有历史记录";
    in-out property <[string]> phrase-rows;
    in-out property <int> phrase-index: 0;
    in-out property <string> phrase-trigger: "";
    in-out property <string> phrase-body: "";
    in-out property <string> num-imgbytes: "15728640";

    in-out property <string> rec-fj: "Ctrl+G";
    in-out property <string> num-delay: "0";
    in-out property <bool> opt-autopopup;
    in-out property <bool> opt-autojump;
    in-out property <bool> opt-autosync;
    in-out property <bool> follow-visible;
    in-out property <string> follow-label: "跟随对话框";
    in-out property <bool> opt-inject;
    in-out property <bool> opt-evsearch;
    in-out property <string> num-recentmax: "5";
    in-out property <string> num-addmin: "1";

    in-out property <bool> opt-qf;
    in-out property <string> qf-open-label: "从资源管理器打开";
    in-out property <string> num-qfmax: "150";
    in-out property <bool> opt-pt;
    in-out property <bool> mask-caps;
    in-out property <bool> mask-shift;
    in-out property <bool> mask-ctrl;
    in-out property <bool> mask-alt;
    in-out property <bool> mask-win;
    in-out property <bool> opt-keepkeys;
    in-out property <[string]> rule-rows;
    in-out property <string> rec-rule: "录制组合键…";
    in-out property <[string]> excl-rows;
    in-out property <[string]> proc-list;
    in-out property <int> proc-index: 0;

    in-out property <[string]> custom-rows;
    in-out property <string> custom-path: "";
    in-out property <string> custom-import-path: "";

    in-out property <string> error-text: "";
    // 普通通知行（非错误）：与 error-text 并列的第二条展示位，样式中性。
    in-out property <string> notice-text: "";
    in-out property <int> recording: -1;

    // ===== 关于页（page 5）=====
    in-out property <string> app-version: "";
    in-out property <string> app-build: "";
    in-out property <string> app-data-dir: "";
    // 更新状态机（关于页「更新」区）：status 是给人看的一句话，其余驱动 UI 形态。
    // busy = 正在检查/下载/安装；progress < 0 = 不确定态（服务端未给总长）。
    in-out property <string> update-status: "";
    in-out property <bool> update-busy: false;
    in-out property <float> update-progress: -1;
    in-out property <bool> update-available: false;
    in-out property <bool> update-status-warn: false;

    callback setting-bool(string);
    callback setting-cycle(string);
    callback setting-record(int);
    callback setting-key(string, int, int);
    callback setting-key-rel(string);
    callback setting-text(string, string);
    callback setting-save();
    callback setting-cancel();
    callback setting-clear();
    callback excl-add();
    callback excl-del(int);
    callback proc-selected(string);
    callback rule-del(int);
    callback custom-del(int);
    callback custom-import();
    callback custom-export();
    callback phrase-sel(int);
    callback page-changed(int);
    // 常规页（page 2）：数据维护动作，点了立刻执行（不是草稿，无需保存）
    callback general-export();
    callback general-import();
    callback general-open-data();
    // 文件夹跳转页：探测工具，随「自定义对话框」一起并进了跳转页
    callback fj-probe();
    // 关于页
    callback about-check-update();
    callback about-install-update();
    callback about-open-repo();
    callback about-open-releases();
    // 老版 WPF 迁移收尾（设置 → 关于）：停用老版开机自启
    callback about-disable-legacy();

    // 老版迁移收尾卡片态：仅检测到老版仍在自启/运行时可见
    in-out property <bool> legacy-visible: false;
    in-out property <bool> legacy-has-autostart: false;
    in-out property <bool> legacy-busy: false;
    in-out property <string> legacy-status: "";

    title: "clipx 设置";
    icon: @image-url("../assets/tray.png");
    // 打开期间置顶：呼出时前台常是别的进程，抢焦点会被 Windows 前台锁拒绝，
    // 视觉置顶交给 Slint/winit 的 always-on-top，不依赖任何 Win32 权限。
    always-on-top: true;
    min-width: 580px;
    min-height: 640px;
    preferred-width: 640px;
    preferred-height: 720px;
    background: Theme.window-bg;

    in-out property <int> page: 0;

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Rectangle {
            height: 44px;
            border-radius: 10px;
            background: Theme.header-bg;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                UiTab { text: "剪贴板"; active: root.page == 0; clicked => { root.page = 0; root.page-changed(0); } }
                UiTab { text: "记录与检索"; active: root.page == 1; clicked => { root.page = 1; root.page-changed(1); } }
                UiTab { text: "常规"; active: root.page == 2; clicked => { root.page = 2; root.page-changed(2); } }
                UiTab { text: "文件夹跳转"; active: root.page == 3; clicked => { root.page = 3; root.page-changed(3); } }
                UiTab { text: "高级"; active: root.page == 4; clicked => { root.page = 4; root.page-changed(4); } }
                UiTab { text: "关于"; active: root.page == 5; clicked => { root.page = 5; root.page-changed(5); } }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: Theme.window-bg;
        // ===== 剪贴板页（page 0）=====
        // 只装「日常使用面板」相关的项：呼出与快捷键 / 面板外观 / 选择与粘贴。
        // 容量、OCR、检索、短语已移到「记录与检索」页（page 1）；
        // 清空历史移到「常规」页的「危险操作」区。
        if root.page == 0: UiScroll {
                UiSection { text: "呼出与快捷键"; }
                UiRow {
                    label: "呼出快捷键";
                    UiChip {
                        text: root.recording == 0 ? "按下快捷键… Esc 取消" : root.rec-main;
                        armed: root.recording == 0;
                        clicked => { root.setting-record(0); }
                    }
                }
                UiRow {
                    label: "批量模式切换";
                    UiChip {
                        text: root.recording == 1 ? "按下快捷键… Esc 取消" : root.rec-batch;
                        armed: root.recording == 1;
                        clicked => { root.setting-record(1); }
                    }
                }
                UiRow {
                    label: "向上翻页";
                    UiChip {
                        text: root.recording == 3 ? "按下快捷键… Esc 取消" : root.rec-pgup;
                        armed: root.recording == 3;
                        clicked => { root.setting-record(3); }
                    }
                }
                UiRow {
                    label: "向下翻页";
                    UiChip {
                        text: root.recording == 4 ? "按下快捷键… Esc 取消" : root.rec-pgdn;
                        armed: root.recording == 4;
                        clicked => { root.setting-record(4); }
                    }
                }
                UiRow {
                    label: "面板主键";
                    help: "数字快贴 / 短语过滤";
                    UiChip { text: root.panel-label; clicked => { root.setting-cycle("panel"); } }
                }
                UiRow {
                    label: "每次翻页条数";
                    help: "1 ~ 50";
                    UiField { text: root.num-pageitems; edited(t) => { root.setting-text("pageitems", t); } }
                }
                // 快捷键速查从「关于」页搬来：它讲的就是本区这几个键，
                // 放在设置项旁边才对得上号，摆在关于页是脱节的。
                Text {
                    text: "主面板：Ctrl+` 呼出 · ↑↓ 选择 · Enter 粘贴 · Space 预览 / 检索态分词 · Del 删除 · Ctrl+P 置顶 · Tab 切换模式。托盘图标左键单击 = 显示 / 隐藏。";
                    font-size: 12px;
                    color: Theme.secondary-text;
                    wrap: word-wrap;
                }
                UiSection { text: "面板外观"; }
                UiRow {
                    label: "外观主题";
                    UiChip { text: root.theme-label; clicked => { root.setting-cycle("theme"); } }
                }
                UiRow {
                    label: "不透明度";
                    HorizontalLayout {
                        spacing: 10px;
                        UiSlider {
                            value <=> root.opacity-val;
                            minimum: 0.4;
                            maximum: 1.0;
                            horizontal-stretch: 1;
                            changed(v) => { root.setting-text("opacity", v); }
                        }
                        Text {
                            text: "\{Math.round(root.opacity-val * 100.0)}%";
                            width: 40px;
                            color: Theme.secondary-text;
                            vertical-alignment: center;
                            font-size: 12px;
                        }
                    }
                }
                UiRow {
                    label: "面板宽度";
                    help: "280 ~ 1200";
                    UiField { text: root.num-width; edited(t) => { root.setting-text("width", t); } }
                }
                UiRow {
                    label: "面板最大高度";
                    help: "200 ~ 900";
                    UiField { text: root.num-maxheight; edited(t) => { root.setting-text("maxheight", t); } }
                }
                UiRow {
                    label: "预览行数";
                    help: "1 ~ 10";
                    UiField { text: root.num-preview-lines; edited(t) => { root.setting-text("preview", t); } }
                }
                UiRow {
                    label: "弹出位置";
                    UiChip { text: root.pos-label; clicked => { root.setting-cycle("pos"); } }
                }
                UiRow {
                    label: "点击外部隐藏";
                    UiChip { text: root.hide-label; clicked => { root.setting-cycle("hide"); } }
                }
                // 「粘贴与识别」原先把系统集成（Win+V）、粘贴行为、OCR、检索、容量
                // 混在一区。现已按语义拆开：粘贴类留在本页，OCR / 检索 / 容量
                // 归到「记录与检索」页。
                UiSection { text: "选择与粘贴"; }
                UiRow {
                    label: "双击才粘贴";
                    help: "开 = 单击仅选中";
                    UiToggle { checked <=> root.opt-dblclick; toggled => { root.setting-bool("dblclick"); } }
                }
                UiRow {
                    label: "粘贴后置顶";
                    help: "开 = 贴过的条目排到最上（对齐老版）";
                    UiToggle { checked <=> root.opt-touch; toggled => { root.setting-bool("touch"); } }
                }
                UiRow {
                    label: "粘贴模式";
                    help: "终端目标自动改用 Shift+Insert";
                    UiChip { text: root.paste-label; clicked => { root.setting-cycle("paste"); } }
                }
                UiRow {
                    label: "模拟粘贴";
                    help: "写回后向目标窗发送粘贴键";
                    UiToggle { checked <=> root.opt-simulate; toggled => { root.setting-bool("simulate"); } }
                }
                UiRow { label: "替换系统 Win+V"; UiToggle { checked <=> root.opt-winv; toggled => { root.setting-bool("winv"); } } }
                UiRow {
                    label: "文本批量合并粘贴";
                    help: "相邻纯文本合一段；关则逐条";
                    UiToggle { checked <=> root.opt-merge; toggled => { root.setting-bool("merge"); } }
                }
                UiRow { label: "队列贴完后回普通模式"; UiToggle { checked <=> root.opt-autooff; toggled => { root.setting-bool("autooff"); } } }
        }

        // ===== 记录与检索页（page 1）=====
        // 从原「剪贴板」页拆出来：存多少（容量）、怎么找（检索 / OCR）、以及短语。
        // 「剪贴板」页只留日常使用面板所需的项，不再跟这些混在一起。
        if root.page == 1: UiScroll {
                UiSection { text: "容量"; }
                UiRow {
                    label: "最大记录数";
                    help: "10 ~ 100000";
                    UiField { text: root.num-max-items; edited(t) => { root.setting-text("max_items", t); } }
                }
                UiRow {
                    label: "最大图片条数";
                    help: "0 = 不限制，上限 5000";
                    UiField { text: root.num-max-images; edited(t) => { root.setting-text("max_images", t); } }
                }
                UiRow {
                    label: "单图体积上限";
                    help: "字节";
                    UiField { text: root.num-imgbytes; field-width: 160px; edited(t) => { root.setting-text("imgbytes", t); } }
                }

                UiSection { text: "检索"; }
                UiRow {
                    label: "全文深搜";
                    help: "开则扫正文与 OCR";
                    UiToggle { checked <=> root.opt-deep; toggled => { root.setting-bool("deep"); } }
                }

                UiSection { text: "图片文字识别"; }
                UiRow {
                    label: "图片文字识别";
                    help: "关后停新图 OCR，旧结果保留";
                    UiToggle { checked <=> root.opt-ocr; toggled => { root.setting-bool("ocr"); } }
                }
                UiRow {
                    label: "OCR 引擎";
                    help: "自动=有拓展包用拓展包；切换需重启";
                    UiChip { text: root.ocr-engine-label; clicked => { root.setting-cycle("ocrengine"); } }
                }

                UiSection { text: "快捷短语"; }
                for p[i] in root.phrase-rows: Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: i == root.phrase-index ? Theme.selected : Theme.surface;
                    border-width: 1px;
                    border-color: i == root.phrase-index ? Theme.accent : Theme.border;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: p;
                        font-size: 12px;
                        color: Theme.primary-text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.phrase-sel(i); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    UiBtn { text: "新增空短语"; clicked => { root.setting-text("phrase-add", ""); } }
                    UiBtn { text: "删除选中"; danger: true; clicked => { root.setting-text("phrase-del", ""); } }
                }
                UiRow { label: "触发词"; UiField { text: root.phrase-trigger; field-width: 180px; edited(t) => { root.setting-text("ptrig", t); } } }
                UiRow { label: "正文"; UiField { text: root.phrase-body; field-width: 240px; edited(t) => { root.setting-text("pbody", t); } } }
        }

        // ===== 常规页（page 2）=====
        // 程序级设置：启动 / 数据维护 / 危险操作。
        // 更新相关（开关 + 检查/下载/进度）已集中到「关于」页，这里不再重复。
        // 破坏性动作（清空全部历史）单独成区，不再埋在「快捷短语」末尾。
        if root.page == 2: UiScroll {
                UiSection { text: "启动"; }
                UiRow { label: "开机自启动"; UiToggle { checked <=> root.opt-startup; toggled => { root.setting-bool("startup"); } } }
                UiRow {
                    label: "以管理员身份启动";
                    help: "每次启动弹 UAC";
                    UiToggle { checked <=> root.opt-admin; toggled => { root.setting-bool("admin"); } }
                }

                UiSection { text: "数据维护"; }
                Text {
                    text: "导出文件是历史库的完整副本，可在另一台机器上用「导入历史」合并回来（按内容去重）。数据目录路径见「关于」页。";
                    font-size: 12px;
                    color: Theme.secondary-text;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    // 按钮保持自身宽度（UiBtn 的 min-width），别被 layout 拉成满行
                    alignment: start;
                    UiBtn { text: "导出历史…"; clicked => { root.general-export(); } }
                    UiBtn { text: "导入历史…"; clicked => { root.general-import(); } }
                    UiBtn { text: "打开数据目录"; clicked => { root.general-open-data(); } }
                }
                UiRow {
                    label: "退出时清空历史";
                    help: "仅清历史，短语保留";
                    UiToggle { checked <=> root.opt-clearexit; toggled => { root.setting-bool("clearexit"); } }
                }

                UiSection { text: "危险操作"; }
                Text {
                    text: "下面的操作不可撤销。清空只影响历史记录，快捷短语会保留。";
                    font-size: 12px;
                    color: Theme.secondary-text;
                    wrap: word-wrap;
                }
                UiRow {
                    label: "历史记录";
                    help: "两段确认，防误触";
                    UiBtn {
                        text: root.clear-label;
                        danger: root.clear-armed;
                        clicked => { root.setting-clear(); }
                    }
                }
        }

        // ===== 文件夹跳转页（page 3）=====
        // 原「自定义对话框」独立页已并入本页末尾：它就是跳转的补充配置
        //（内置识别不到的窗口），理应和跳转设置、探测工具待在一起，
        // 不用再跨 tab 来回找。
        if root.page == 3: UiScroll {
                UiSection { text: "文件对话框跳转"; }
                UiRow {
                    label: "启用跳转";
                    help: "关则不检测对话框";
                    UiToggle { checked <=> root.opt-fj; toggled => { root.setting-bool("fj"); } }
                }
                UiRow {
                    label: "跳转快捷键";
                    UiChip {
                        text: root.recording == 2 ? "按下快捷键… Esc 取消" : root.rec-fj;
                        armed: root.recording == 2;
                        clicked => { root.setting-record(2); }
                    }
                }
                UiRow {
                    label: "列表延时";
                    help: "0~10000 ms，延时内再按直跳预选项";
                    UiField { text: root.num-delay; edited(t) => { root.setting-text("delay", t); } }
                }
                UiRow { label: "对话框打开时自动弹出"; UiToggle { checked <=> root.opt-autopopup; toggled => { root.setting-bool("autopopup"); } } }
                UiRow {
                    label: "自动跳转到最佳路径";
                    help: "直跳首条，同框只跳一次";
                    UiToggle { checked <=> root.opt-autojump; toggled => { root.setting-bool("autojump"); } }
                }
                UiRow { label: "切回时自动同步路径"; UiToggle { checked <=> root.opt-autosync; toggled => { root.setting-bool("autosync"); } } }
                if root.follow-visible: UiRow {
                    label: "跳转列表跟随";
                    UiChip { text: root.follow-label; clicked => { root.setting-cycle("follow"); } }
                }
                UiRow {
                    label: "Shell 注入跳转";
                    help: "关则只模拟地址栏；WPS 恒不注入";
                    UiToggle { checked <=> root.opt-inject; toggled => { root.setting-bool("inject"); } }
                }
                UiRow { label: "Everything 补充文件夹"; UiToggle { checked <=> root.opt-evsearch; toggled => { root.setting-bool("evsearch"); } } }
                UiRow {
                    label: "常用路径最大数量";
                    help: "1 ~ 10";
                    UiField { text: root.num-recentmax; edited(t) => { root.setting-text("recentmax", t); } }
                }
                UiRow {
                    label: "自动加入常用阈值";
                    help: "确认 N 次后入库";
                    UiField { text: root.num-addmin; edited(t) => { root.setting-text("addmin", t); } }
                }

                UiSection { text: "自定义对话框"; }
                Text {
                    text: "内置识别不到的「打开 / 保存」窗口，按类名 + 进程名匹配。点「探测文件对话框」抓当前前台窗口，再把结果填进来。";
                    font-size: 12px;
                    color: Theme.secondary-text;
                    wrap: word-wrap;
                }
                for c[i] in root.custom-rows: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: c;
                        color: Theme.primary-text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        font-size: 12px;
                    }
                    UiBtn { text: "删除"; danger: true; clicked => { root.custom-del(i); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    UiBtn { text: "探测文件对话框"; clicked => { root.fj-probe(); } }
                    UiBtn { text: "导入（合并）"; clicked => { root.custom-import(); } }
                    UiBtn { text: "导出全部"; clicked => { root.custom-export(); } }
                }
                UiField {
                    text: root.custom-import-path;
                    field-width: 520px;
                    edited(t) => { root.setting-text("custom-path", t); }
                }
                Text {
                    text: "存储文件：" + root.custom-path;
                    font-size: 11px;
                    color: Theme.muted-text;
                }
        }

        // ===== 高级页（page 4）=====
        // 原「实验性」页。里面两块（资源管理器快速查找、按键穿透）早已稳定在用，
        // 旧名字既让人不敢碰、又搜不到，换成中性名。
        if root.page == 4: UiScroll {
                UiSection { text: "资源管理器快速查找"; }
                UiRow { label: "当前文件夹内键入筛选"; UiToggle { checked <=> root.opt-qf; toggled => { root.setting-bool("qf"); } } }
                UiRow { label: "选中操作"; UiChip { text: root.qf-open-label; clicked => { root.setting-cycle("qfopen"); } } }
                UiRow {
                    label: "筛选最大条数";
                    help: "1 ~ 2000";
                    UiField { text: root.num-qfmax; edited(t) => { root.setting-text("qfmax", t); } }
                }
                UiSection { text: "按键穿透"; }
                UiRow {
                    label: "按键穿透";
                    help: "面板开时把键交给外部钩子";
                    UiToggle { checked <=> root.opt-pt; toggled => { root.setting-bool("pt"); } }
                }
                UiRow {
                    label: "穿透修饰键";
                    HorizontalLayout {
                        spacing: 8px;
                        UiChip { text: "Caps"; armed: root.mask-caps; clicked => { root.mask-caps = !root.mask-caps; root.setting-bool("mask-caps"); } }
                        UiChip { text: "Shift"; armed: root.mask-shift; clicked => { root.mask-shift = !root.mask-shift; root.setting-bool("mask-shift"); } }
                        UiChip { text: "Ctrl"; armed: root.mask-ctrl; clicked => { root.mask-ctrl = !root.mask-ctrl; root.setting-bool("mask-ctrl"); } }
                        UiChip { text: "Alt"; armed: root.mask-alt; clicked => { root.mask-alt = !root.mask-alt; root.setting-bool("mask-alt"); } }
                        UiChip { text: "Win"; armed: root.mask-win; clicked => { root.mask-win = !root.mask-win; root.setting-bool("mask-win"); } }
                    }
                }
                UiRow { label: "保留面板导航键"; UiToggle { checked <=> root.opt-keepkeys; toggled => { root.setting-bool("keepkeys"); } } }
                UiSection { text: "穿透规则"; }
                UiChip {
                    text: root.recording == 100 ? "按下组合键… Esc 取消" : root.rec-rule;
                    armed: root.recording == 100;
                    clicked => { root.setting-record(100); }
                }
                for r[i] in root.rule-rows: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: r;
                        color: Theme.primary-text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        font-size: 12px;
                    }
                    UiBtn { text: "删除"; danger: true; clicked => { root.rule-del(i); } }
                }
                UiSection { text: "排除应用"; }
                Text {
                    text: "前台属于这些进程时，全局热键不触发";
                    font-size: 11px;
                    color: Theme.muted-text;
                }
                for e[i] in root.excl-rows: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: e;
                        color: Theme.primary-text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        font-size: 12px;
                    }
                    UiBtn { text: "删除"; danger: true; clicked => { root.excl-del(i); } }
                }
                Text { text: "最近进程"; font-size: 11px; color: Theme.muted-text; }
                for p[i] in root.proc-list: Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: i == root.proc-index ? Theme.selected : transparent;
                    Text {
                        x: 8px;
                        text: p;
                        font-size: 12px;
                        color: Theme.primary-text;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.proc-selected(p); }
                    }
                }
                UiBtn { text: "添加到排除"; clicked => { root.excl-add(); } }
        }

        if root.page == 5: UiScroll {
                UiSection { text: "关于 clipx"; }
                Text {
                    text: "Rust + Slint 写成的 Windows 剪贴板管理器。前身是 WPF 版 ClipboardX —— 它的交互行为是本项目的规格书，老数据可在首次启动时自动导入。";
                    font-size: 12px;
                    color: Theme.secondary-text;
                    wrap: word-wrap;
                }
                UiRow {
                    label: "当前版本";
                    Text {
                        text: root.app-version;
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.primary-text;
                        vertical-alignment: center;
                    }
                }
                UiRow {
                    label: "构建";
                    Text {
                        text: root.app-build;
                        font-size: 12px;
                        color: Theme.secondary-text;
                        vertical-alignment: center;
                    }
                }

                // ===== 老版 WPF 迁移收尾 =====
                // 只在检测到老版还在自启/运行时出现：历史虽已导入，但老版继续监听
                // 剪贴板会与 clipx 双份运行（热键相撞、数据分叉）。这里只停它的自启，
                // 卸载交给用户走老版自己的向导（且必须选「否」保留数据）。
                if root.legacy-visible: UiSection { text: "老版 ClipboardX 迁移收尾"; }
                if root.legacy-visible: Text {
                    text: root.legacy-status;
                    font-size: 12px;
                    color: Theme.secondary-text;
                    wrap: word-wrap;
                }
                if root.legacy-visible: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    UiBtn {
                        text: root.legacy-busy ? "处理中…" : "停用老版开机自启";
                        // 已经停过（没自启项了）就没必要再点
                        enabled: root.legacy-has-autostart && !root.legacy-busy;
                        primary: true;
                        clicked => { root.about-disable-legacy(); }
                    }
                }
                if root.legacy-visible: Text {
                    text: "停用只移除开机自启，不动老版程序与历史数据。确认历史已导入后，可运行老版卸载程序——卸载时选「否」保留数据，切勿选「是」（会一并删除历史库）。";
                    font-size: 12px;
                    color: Theme.danger;
                    wrap: word-wrap;
                }

                UiSection { text: "更新"; }                // 状态行：始终显示「当前处于什么状态」——已是最新 / 发现新版本 / 检查中 /
                // 下载中（带百分比）/ 安装中 / 上次检查失败。没有它，用户点完「检查更新」
                // 只能干等右下角那条 2 秒就消失的提示条。
                Text {
                    text: root.update-status;
                    font-size: 12px;
                    color: root.update-status-warn ? Theme.danger : Theme.secondary-text;
                    wrap: word-wrap;
                }
                // 进度条：仅下载中显示。negative progress = 服务端没给 Content-Length，
                // 走不确定态（半透明底 + 提示文字），此时不画填充。
                if root.update-busy: Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.border;
                    Rectangle {
                        // progress < 0 → 不确定态：填充 100% 宽但压暗，纯示意
                        width: root.update-progress < 0
                            ? parent.width
                            : max(0px, parent.width * root.update-progress);
                        height: parent.height;
                        border-radius: 3px;
                        background: root.update-progress < 0 ? Theme.border : Theme.accent;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    // 按钮保持自身宽度（UiBtn 的 min-width），别被 layout 拉成满行
                    alignment: start;
                    UiBtn {
                        text: root.update-busy ? "更新中…" : "检查更新";
                        primary: true;
                        // 下载/安装进行中时禁用，避免并发重入
                        enabled: !root.update-busy;
                        clicked => { root.about-check-update(); }
                    }
                    // 仅在有新版本时出现 —— 平时它是误导（点了也没东西可装）。
                    if root.update-available && !root.update-busy: UiBtn {
                        text: "下载并安装";
                        primary: true;
                        clicked => { root.about-install-update(); }
                    }
                    UiBtn { text: "下载页"; enabled: !root.update-busy; clicked => { root.about-open-releases(); } }
                    UiBtn { text: "项目主页"; clicked => { root.about-open-repo(); } }
                }
                UiRow {
                    label: "启动时自动检查更新";
                    UiToggle { checked <=> root.opt-updates; toggled => { root.setting-bool("updates"); } }
                }
                UiRow {
                    label: "发现新版本时自动下载并安装";
                    UiToggle { checked <=> root.opt-autoupdate; toggled => { root.setting-bool("autoupdate"); } }
                }
                Text {
                    text: "关闭自动安装时，发现新版本会提示你，点上方「下载并安装」才执行。";
                    font-size: 11px;
                    color: Theme.muted-text;
                    wrap: word-wrap;
                }

                UiSection { text: "数据目录"; }
                Text {
                    text: "历史库、设置、预览缓存与导出文件都放在这里。反馈问题时可带上版本号与构建标识；目录可用「常规」页的「打开数据目录」直接打开。";
                    font-size: 12px;
                    color: Theme.secondary-text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.app-data-dir;
                    font-size: 11px;
                    color: Theme.muted-text;
                    wrap: word-wrap;
                }
        }
        }

        if root.error-text != "": Rectangle {
            border-radius: 8px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.danger;
            VerticalLayout {
                padding: 8px;
                Text {
                    text: root.error-text;
                    font-size: 12px;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
            }
        }
        // 普通通知行：中性描边，与上方错误行区分开（通知不是故障，不该用红框吓人）。
        if root.notice-text != "" && root.error-text == "": Rectangle {
            border-radius: 8px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 8px;
                Text {
                    text: root.notice-text;
                    font-size: 12px;
                    color: Theme.secondary-text;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            UiBtn { text: "取消"; clicked => { root.setting-cancel(); } }
            UiBtn { text: "保存"; primary: true; clicked => { root.setting-save(); } }
        }
    }

    // 热键录制覆盖层：仅录制期存在。Slint 直收按键（含修饰位），不依赖低级钩子
    //（钩子被系统静默摘除/链顺序异常时录制仍可用；F 键等无文本键走钩子兜底）。
    // FocusScope 无绘制、不吃鼠标，点击可穿透到下面的按钮（再点即取消）。
    if root.recording >= 0: rec-scope := FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            root.setting-key(event.text,
                (event.modifiers.alt ? 1 : 0) + (event.modifiers.control ? 2 : 0)
                + (event.modifiers.shift ? 4 : 0) + (event.modifiers.meta ? 8 : 0),
                event.repeat ? 1 : 0);
            accept
        }
        key-released(event) => {
            root.setting-key-rel(event.text);
            accept
        }
    }
}
